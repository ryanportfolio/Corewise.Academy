{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guides/choose-the-right-claude-feature",
      "destination": "/guides/a-practical-guide-to-claudes-features/",
      "permanent": true
    },
    {
      "source": "/guides/choose-the-right-claude-feature/",
      "destination": "/guides/a-practical-guide-to-claudes-features/",
      "permanent": true
    },
    {
      "source": "/guides/choose-the-right-claude-feature.md",
      "destination": "/guides/a-practical-guide-to-claudes-features.md",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
