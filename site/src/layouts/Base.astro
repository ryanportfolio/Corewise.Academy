---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'CoreWise Academy · a celestial atlas of machine minds. Original guides on working with AI, distilled from the best teachers on the open web.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <!-- fonts are self-hosted (see src/styles/fonts.css), no third-party requests.
         Preload the three faces that paint above the fold. -->
    <link rel="preload" href="/fonts/AlembicTitling.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/newsreader-normal-400_700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // theme before first paint: no flash of the wrong lecture
      document.documentElement.dataset.theme = localStorage.getItem('cw-theme') || 'day';
    </script>
  </head>
  <body class="grain">
    <header class="masthead">
      <a class="wordmark" href="/">CoreWise <em>Academy</em></a>
      <nav>
        <a href="/#tracks">Constellations</a>
        <a href="/about/">About</a>
        <a href="/how-its-built/">How it’s charted</a>
        <button class="session-toggle" id="toggle" aria-label="Switch between day and night theme">
          <span class="toggle-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g class="ti-sun">
                <circle cx="8" cy="8" r="2.6" stroke="currentColor" stroke-width="1" />
                <g class="ti-rays" stroke="currentColor" stroke-width="0.9" stroke-linecap="round">
                  <line x1="12.3" y1="8" x2="13.9" y2="8" />
                  <line x1="3.7" y1="8" x2="2.1" y2="8" />
                  <line x1="8" y1="12.3" x2="8" y2="13.9" />
                  <line x1="8" y1="3.7" x2="8" y2="2.1" />
                  <line x1="11.04" y1="11.04" x2="11.75" y2="11.75" />
                  <line x1="4.96" y1="4.96" x2="4.25" y2="4.25" />
                  <line x1="11.04" y1="4.96" x2="11.75" y2="4.25" />
                  <line x1="4.96" y1="11.04" x2="4.25" y2="11.75" />
                </g>
              </g>
              <g class="ti-moon">
                <path d="M9.8 3.2 A4.9 4.9 0 1 0 9.8 12.8 A5.8 5.8 0 0 1 9.8 3.2 Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
                <path class="ti-star" d="M12.2 3 L12.62 3.98 L13.6 4.4 L12.62 4.82 L12.2 5.8 L11.78 4.82 L10.8 4.4 L11.78 3.98 Z" fill="currentColor" />
              </g>
            </svg>
          </span><span id="toggle-label">DAY</span>
        </button>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <span>CoreWise Academy · charted nightly · no mind left unmapped</span>
      <span><a href="/how-its-built/">How it’s charted →</a></span>
      <span>Edited by Ryan · Vol. I</span>
    </footer>

    <script>
      const root = document.documentElement;
      const label = document.getElementById('toggle-label')!;
      const apply = (t: string) => {
        root.dataset.theme = t;
        label.textContent = t === 'night' ? 'NIGHT' : 'DAY';
      };
      apply(localStorage.getItem('cw-theme') || 'day');
      document.getElementById('toggle')!.addEventListener('click', () => {
        const next = root.dataset.theme === 'night' ? 'day' : 'night';
        localStorage.setItem('cw-theme', next);
        apply(next);
      });

      // scroll reveal: unobserve once
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style is:global>
      @import '../styles/fonts.css';
      @import '../styles/tokens.css';

      .masthead {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--s-2) var(--s-4);
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--paper) 84%, transparent);
        backdrop-filter: blur(10px);
        transition: background var(--dur) var(--ease);
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: var(--text-md);
        letter-spacing: 0.02em;
        color: var(--ink);
        text-decoration: none;
      }
      .wordmark em { font-style: normal; color: var(--accent-deep); }
      .masthead nav { display: flex; gap: var(--s-4); align-items: center; }
      .masthead nav a {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
      }
      .masthead nav a:hover { color: var(--accent-deep); }
      .session-toggle {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-caps);
        border: 1px solid var(--line);
        background: none;
        color: var(--ink-soft);
        padding: 6px 12px;
        cursor: pointer;
        display: inline-flex;
        gap: 8px;
        align-items: center;
        transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
      }
      .session-toggle:hover { color: var(--accent-deep); border-color: var(--accent); }
      .session-toggle .toggle-icon {
        width: 15px;
        height: 15px;
        display: inline-flex;
        color: var(--accent);
        filter: drop-shadow(0 0 3px var(--glow));
      }
      .session-toggle .toggle-icon svg { width: 100%; height: 100%; overflow: visible; }
      /* engraved sun and crescent share the box; the active one shows.
         Both rotate through the swap so the change reads as one dial turning. */
      .ti-sun, .ti-moon {
        transform-origin: 8px 8px;
        transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
      }
      .ti-moon { opacity: 0; transform: rotate(-60deg) scale(0.55); }
      [data-theme='night'] .ti-sun { opacity: 0; transform: rotate(60deg) scale(0.55); }
      [data-theme='night'] .ti-moon { opacity: 1; transform: none; }
      /* ambient: the sun's rays revolve like a slow instrument dial */
      .ti-rays {
        transform-origin: 8px 8px;
        animation: ti-revolve 80s linear infinite;
      }
      @keyframes ti-revolve { to { transform: rotate(360deg); } }
      /* ambient: the star in the crescent's opening breathes */
      .ti-star {
        transform-origin: 12.2px 4.4px;
        animation: ti-twinkle 4.5s var(--ease) infinite;
      }
      @keyframes ti-twinkle {
        0%, 100% { opacity: 0.35; transform: scale(0.8); }
        55% { opacity: 1; transform: scale(1); }
      }

      .site-footer {
        border-top: 1px solid var(--line);
        padding: var(--s-4);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--s-2);
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.08em;
        color: var(--ink-mute);
        text-transform: uppercase;
        position: relative;
        z-index: 1;
      }
      .site-footer a { color: var(--ink-soft); }

      .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
      }
      .reveal.in { opacity: 1; transform: none; }

      .btn {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        text-decoration: none;
        padding: 12px 22px;
        border: 1px solid var(--accent-deep);
        color: var(--accent-deep);
        white-space: nowrap;
        transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
      }
      .btn.solid { background: var(--accent-deep); color: var(--paper); }
      .btn:hover { background: var(--accent); color: var(--paper); border-color: var(--accent); }

      .panel-label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: var(--tracking-caps);
        color: var(--accent-deep);
        display: block;
        margin-bottom: var(--s-2);
      }

      @media (max-width: 720px) {
        .masthead nav a { display: none; }
        .masthead { padding: var(--s-2); }
      }
    </style>
  </body>
</html>
