---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import SamplingFigure from '../components/SamplingFigure.astro';
import SkillShelf from '../components/SkillShelf.astro';
import { TOOL_SHELF } from '../data/toolShelf';

const guides = (await getCollection('guides')).filter((g) => g.data.status === 'published');
const totalMinutes = guides.reduce((sum, g) => sum + g.data.minutes, 0);
const shortest = Math.min(...guides.map((g) => g.data.minutes));
const longest = Math.max(...guides.map((g) => g.data.minutes));

const principles = [
  {
    name: 'Useful first',
    line: 'Every guide opens with why it matters to real work and ends with an exercise you can run tonight.',
  },
  {
    name: 'Checkable objectives',
    line: 'The objective box promises plain actions (estimate, restructure, diagnose).',
  },
  {
    name: 'Active recall',
    line: 'Overview at the end of each guide.',
  },
];

const pipeline = [
  { stage: 'Ingest', happens: 'A source video or document is fetched and broken into concepts, misconceptions, exercises, and quotable moments', output: 'Structured notes + source log' },
  { stage: 'Draft', happens: 'The writing tool reads the whole curriculum, then writes an original guide (or extends an existing one)', output: 'MDX draft on a branch' },
  { stage: 'Review', happens: 'The draft arrives as a pull request; the editor reviews, corrects, and merges', output: 'Published guide' },
  { stage: 'Rebuild', happens: 'Merging rebuilds the static site, so publishing and merging are the same act', output: 'Live page' },
];

const faq = [
  {
    q: 'How are the guides made?',
    a: 'Each guide starts from real sources: a lecture the editor learned from, official docs fetched at writing time, or the editor\'s own field notes. Notes from several sources are combined into one original piece, and a human editor reviews every draft as a pull request before it publishes.',
  },
  {
    q: 'How long are the guides?',
    a: `Guides run ${shortest} to ${longest} minutes each, and the whole catalogue is about ${totalMinutes} minutes of reading. A typical guide is made to fit inside one sitting.`,
  },
  {
    q: 'Who checks what gets published?',
    a: '100% of guides pass through the editor, Ryan D. Allen, before they go live. Nothing publishes directly: every draft is a pull request, review notes are resolved, and merging is publishing.',
  },
];
---

<Base
  title="How CoreWise Academy guides get made · CoreWise Academy"
  description="How CoreWise Academy guides get made: real sources, one original guide per topic, a human editor reviewing every draft, and learning science applied on purpose."
  faq={faq}
  crumbs={[{ name: 'How guides get made', path: '/how-its-built/' }]}
>
  <main>
    <p class="mono-label accent">How it’s built</p>
    <h1 class="display">How guides get made</h1>

    <div class="prose">
      <h2><span class="no">01</span>Guides start from real sources</h2>
      <p>
        Most start with a video the editor learned from. The transcript is fetched and broken
        into concepts, prerequisites, misconceptions, exercises, and quotable moments with
        timestamps. Every guide credits its sources on the page.
      </p>

      <h2><span class="no">02</span><a href="/about/">I</a> review every guide</h2>
      <p>
        Nothing publishes directly. Every draft arrives as a pull request; the editor reviews,
        corrects, and merges. Merging is publishing: the site rebuilds and the guide goes live.
      </p>
      <table class="pipeline">
        <thead>
          <tr><th>Stage</th><th>What happens</th><th>What comes out</th></tr>
        </thead>
        <tbody>
          {
            pipeline.map((p) => (
              <tr>
                <td class="stage">{p.stage}</td>
                <td>{p.happens}</td>
                <td class="mono">{p.output}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2><span class="no">03</span>The style book is strict</h2>
      <p>
        The Academy keeps one written style book. A machine checks some of its rules on every
        build and blocks the deploy on any hit; the editor holds the rest in review.
      </p>
      <table class="pipeline">
        <thead>
          <tr><th>Rule</th><th>Held by</th></tr>
        </thead>
        <tbody>
          <tr><td>No em dash anywhere on the site</td><td class="mono">Build gate</td></tr>
          <tr><td>Titles and headings stay under a length cap</td><td class="mono">Build gate</td></tr>
          <tr><td>Plain words, and fewer of them</td><td class="mono">Review</td></tr>
          <tr><td>Say plainly what a thing is</td><td class="mono">Review</td></tr>
          <tr><td>No jargon and no invented words</td><td class="mono">Review</td></tr>
          <tr><td>No walls of text; the content in the shape that fits it</td><td class="mono">Review</td></tr>
        </tbody>
      </table>
      <p>
        These are a sample. The full book lives in skills and permanent memory rules.
      </p>

      <h2><span class="no">04</span>Learning science, applied</h2>
      <ul class="principles">
        {
          principles.map((p) => (
            <li>
              <strong>{p.name}.</strong> {p.line}
            </li>
          ))
        }
      </ul>
      <p>
        They apply the standard findings on <a
          href="https://en.wikipedia.org/wiki/Testing_effect"
          rel="noopener">the testing effect</a> and <a
          href="https://en.wikipedia.org/wiki/Active_recall"
          rel="noopener">active recall</a> to a guide format.
      </p>

      <h2><span class="no">05</span>Figures are atlas plates</h2>
      <p>
        When a guide needs a picture, it is drawn as a plate from the same star atlas, computed
        from the guide's own numbers rather than sketched by hand. The example below plots five
        tries of a model that only works now and then: five stars, one kept at full brightness, the
        rest left dim. Because the figure is generated from the count, it can never disagree with
        the sentence beside it.
      </p>
      <SamplingFigure
        plate="Plate · Specimen"
        fig="Fig. A"
        caption="A worked example: five tries of an unreliable model, one kept. Generated from the count, not drawn by hand."
      />

      <h2><span class="no">06</span>Take the tools</h2>
      <p>
        The skills below are real files from the repo that runs this site. Copy any one, save it
        to the path shown, and run it in your own <a href="https://docs.claude.com/en/docs/claude-code/skills"
          rel="noopener">Claude Code or Codex</a> session. Three of them have a full guide, linked
        on the row.
      </p>
      <SkillShelf groups={TOOL_SHELF} />
    </div>

    <Faq heading="FAQ · how guides get made" items={faq} />
  </main>

  <style>
    main { max-width: calc(var(--measure) + 2 * var(--s-4)); margin: 0 auto; padding: var(--s-8) var(--s-4) var(--s-12); }
    h1 { font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, var(--text-3xl)); margin: var(--s-2) 0 var(--s-3); }
    .dek { font-size: var(--text-md); font-style: italic; color: var(--ink-soft); margin-bottom: var(--s-2); }
    .prose p { margin-bottom: var(--s-3); }
    .prose h2 { font-family: var(--font-body); font-size: var(--text-xl); font-weight: 600; margin: var(--s-6) 0 var(--s-2); }
    .no { color: var(--accent-deep); margin-right: 0.45em; }
    .prose a { color: var(--ink); }
    .prose a:hover { color: var(--accent-deep); }
    .pipeline { border-collapse: collapse; font-size: var(--text-sm); margin: var(--s-3) 0; }
    .pipeline th {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--ink-mute);
      text-align: left;
      border-bottom: 1px solid var(--ink);
      padding: var(--s-1) var(--s-3) var(--s-1) 0;
    }
    .pipeline td { border-bottom: 1px dashed var(--line); padding: var(--s-2) var(--s-3) var(--s-2) 0; vertical-align: top; }
    .pipeline .stage { font-weight: 600; white-space: nowrap; }
    .pipeline .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-soft); }
    .principles { list-style: none; margin: 0 0 var(--s-3); padding: 0; }
    .principles li { border-left: 3px solid var(--accent-deep); padding-left: var(--s-3); margin-bottom: var(--s-3); }
  </style>
</Base>
