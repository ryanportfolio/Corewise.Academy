---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { TRACKS, LEVELS } from '../data/tracks';
import { TAGS, tagByLabel } from '../data/tags';

const guides = (await getCollection('guides')).filter((g) => g.data.status === 'published');
const totalMinutes = guides.reduce((sum, g) => sum + g.data.minutes, 0);
const trackCount = (slug: string) => guides.filter((g) => g.data.track === slug).length;
// The three most frequent tags among a track's guides (ties alphabetical).
const trackTopTags = (slug: string) => {
  const counts = new Map<string, number>();
  for (const g of guides.filter((g) => g.data.track === slug))
    for (const label of g.data.tags) counts.set(label, (counts.get(label) ?? 0) + 1);
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 3)
    .flatMap(([label]) => tagByLabel(label) ?? []);
};

const faq = [
  {
    q: 'What is CoreWise Academy?',
    a: `CoreWise Academy is a free library of original guides on working with AI. Each guide distills real sources (lectures, official docs, field notes) into a short read with objectives, an exercise, and a self-check. There are ${guides.length} published guides, about ${totalMinutes} minutes of reading in total.`,
  },
  {
    q: 'How much does it cost?',
    a: 'Nothing: $0, no account, no signup, no newsletter gate. Admission is 100% free and every guide is open to read in full.',
  },
  {
    q: 'Where should I start?',
    a: 'Start with the Foundations layer if you are new to working with AI, or jump straight to the layer that matches your problem: Prompting & Context, Agents & Automation, Building with AI, or Practice. Levels run Broad, then Practitioner, then Deep, and prerequisites are marked on every guide.',
  },
];

// The catalogue sheet in the order /guides/ prints it, newest first. The three
// cards below and the index plate's key both read from it, so they cannot drift.
const sheet = [...guides].sort(
  (a, b) => +b.data.lastUpdated - +a.data.lastUpdated || b.data.number - a.data.number,
);
const latest = sheet.slice(0, 3);

// ---- The plate of the catalogue: one constellation, drawn large ----------
// The hero above is the live sky. This is a printed page about that sky, so
// every mark here is apparatus the sky itself has none of: a struck figure
// line, open rings as chart symbols, roman numerals, leader lines, called-out
// halos and named stars. Geometry is hand set so it reads as a drawing; the
// data only decides which star is which.
const PLATE_W = 1000;
const PLATE_H = 400;
// The house star, lifted from the hero dek so the plate uses the same glyph.
const PLATE_STAR_D = 'M12 0 L14.88 9.12 L24 12 L14.88 14.88 L12 24 L9.12 14.88 L0 12 L9.12 9.12 Z';
// One ring per layer, in curriculum order, swept left to right. Each ring
// carries three fixed spur points and a leader direction, so the three newest
// guides can hang off any combination of rings without ever colliding or
// running a label off the edge of the plate.
const PLATE_RINGS: { cx: number; cy: number; dir: number; slots: number[][] }[] = [
  { cx: 92, cy: 296, dir: 1, slots: [[156, 236], [62, 208], [180, 344]] },
  { cx: 286, cy: 206, dir: 1, slots: [[344, 148], [236, 126], [318, 290]] },
  { cx: 470, cy: 262, dir: 1, slots: [[534, 200], [420, 174], [520, 338]] },
  { cx: 678, cy: 132, dir: -1, slots: [[624, 64], [738, 78], [706, 218]] },
  { cx: 898, cy: 84, dir: -1, slots: [[834, 38], [848, 150], [938, 170]] },
];
const plateSpine = PLATE_RINGS.map((r, i) => `${i === 0 ? 'M' : 'L'} ${r.cx} ${r.cy}`).join(' ');
// Measured at build so the draw-on stroke never guesses its own length.
const plateSpineLen = Math.ceil(
  PLATE_RINGS.reduce(
    (sum, r, i) =>
      i === 0 ? sum : sum + Math.hypot(r.cx - PLATE_RINGS[i - 1].cx, r.cy - PLATE_RINGS[i - 1].cy),
    0,
  ),
);
const plateStarAt = (x: number, y: number, size: number) =>
  `translate(${(x - size / 2).toFixed(2)} ${(y - size / 2).toFixed(2)}) scale(${(size / 24).toFixed(4)})`;
const plateRingOf = (slug: string) => {
  const i = TRACKS.findIndex((t) => t.slug === slug);
  return i < 0 ? 0 : i;
};
const plateSlotUsed = PLATE_RINGS.map(() => 0);
const plateLit = latest.map((g, i) => {
  const ri = plateRingOf(g.data.track);
  const ring = PLATE_RINGS[ri];
  const used = plateSlotUsed[ri]++;
  const slot = ring.slots[Math.min(used, ring.slots.length - 1)];
  return {
    label: `Nº ${String(g.data.number).padStart(3, '0')}`,
    x: slot[0],
    y: slot[1],
    rx: ring.cx,
    ry: ring.cy,
    dir: ring.dir,
    anchor: ring.dir === 1 ? 'start' : 'end',
    delay: `${(i * 1.5).toFixed(1)}s`,
  };
});
// The faint field: every guide that is not one of the three carded above.
// Positions come from a hash of the guide's own catalogue number, so the plate
// is byte identical on every build and a new guide only ever adds one star.
const plateLitIds = new Set(latest.map((g) => g.id));
const PLATE_LEVEL_R: Record<string, number> = { broad: 1.9, practitioner: 2.5, deep: 3.2 };
const plateNoise = (n: number, salt: number) => {
  let h = Math.imul(n + salt * 977 + 1, 2654435761) >>> 0;
  h = Math.imul(h ^ (h >>> 15), 2246822519) >>> 0;
  h = (h ^ (h >>> 13)) >>> 0;
  return h / 4294967296;
};
const plateField = guides
  .filter((g) => !plateLitIds.has(g.id))
  .map((g) => ({
    x: +(28 + plateNoise(g.data.number, 1) * (PLATE_W - 56)).toFixed(1),
    y: +(26 + plateNoise(g.data.number, 2) * (PLATE_H - 52)).toFixed(1),
    r: PLATE_LEVEL_R[g.data.level] ?? 2.2,
    // the fill token is already translucent, so a low floor here leaves the
    // field invisible on warm paper; 0.5 keeps it faint but present in both themes
    o: +(0.5 + plateNoise(g.data.number, 3) * 0.4).toFixed(2),
  }));
const count = (track: string, level: string) =>
  guides.filter((g) => g.data.track === track && g.data.level === level).length;
const monthYear = (d: Date) =>
  `${d.toLocaleString('en', { month: 'long' })} MMXXVI`.replace('2026', 'MMXXVI');

// The margin panel rotates three of the guides' chalk lines on every page load.
// The pool is read from the guide sources, so a new guide joins it for free.
const guideSources = import.meta.glob<string>('../content/guides/**/*.mdx', {
  query: '?raw',
  import: 'default',
  eager: true,
});
// Chalk lines are written lowercase and unpunctuated; the panel sets them as
// sentences, and any quoted phrase nests inside the blockquote's own quotes.
const typeset = (line: string) =>
  (line.charAt(0).toUpperCase() + line.slice(1))
    .replace(/"([^"]+)"/g, '‘$1’')
    .replace(/'/g, '’')
    .replace(/([^.!?])$/, '$1.');
const quotePool = guides.flatMap((g) => {
  const [, source] = Object.entries(guideSources).find(([path]) => path.endsWith(`/${g.id}.mdx`)) ?? [];
  const chalk = source?.match(/<Chalk>([\s\S]*?)<\/Chalk>/)?.[1].trim();
  return chalk ? [{ quote: typeset(chalk), title: g.data.title, href: `/guides/${g.id}/` }] : [];
});
const shuffle = <T,>(items: T[]) =>
  items
    .map((item) => ({ item, k: Math.random() }))
    .sort((a, b) => a.k - b.k)
    .map(({ item }) => item);
// Rendered three: what crawlers and no-JS readers get. The script below swaps in
// a fresh three before first paint.
const seedQuotes = shuffle(quotePool).slice(0, 3);
const quotePoolJson = JSON.stringify(quotePool).replace(/</g, '\\u003c');

const minis: Record<string, string> = {
  foundations:
    '<svg class="mini" width="64" height="26" viewBox="0 0 64 26"><g fill="currentColor" stroke="currentColor"><circle cx="8" cy="18" r="2.2"/><circle cx="22" cy="8" r="1.7"/><circle cx="36" cy="14" r="2.6"/><circle cx="50" cy="6" r="1.7"/><circle cx="58" cy="16" r="2"/><path d="M8 18 L22 8 L36 14 L50 6 L58 16" fill="none" stroke-width="0.9" stroke-dasharray="1 2.5"/></g></svg>',
  prompting:
    '<svg class="mini" width="64" height="26" viewBox="0 0 64 26"><g fill="currentColor" stroke="currentColor"><circle cx="6" cy="6" r="1.8"/><circle cx="20" cy="20" r="2.4"/><circle cx="34" cy="6" r="1.8"/><circle cx="48" cy="20" r="2.4"/><circle cx="60" cy="8" r="1.8"/><path d="M6 6 L20 20 L34 6 L48 20 L60 8" fill="none" stroke-width="0.9" stroke-dasharray="1 2.5"/></g></svg>',
  agents:
    '<svg class="mini" width="64" height="26" viewBox="0 0 64 26"><g fill="currentColor" stroke="currentColor"><circle cx="6" cy="20" r="2"/><circle cx="26" cy="14" r="1.7"/><circle cx="44" cy="9" r="2.4"/><circle cx="58" cy="5" r="1.7"/><path d="M6 20 L26 14 L44 9 L58 5 M50 11 L58 5 L52 3" fill="none" stroke-width="0.9" stroke-dasharray="1 2.5"/></g></svg>',
  building:
    '<svg class="mini" width="64" height="26" viewBox="0 0 64 26"><g fill="currentColor" stroke="currentColor"><circle cx="12" cy="6" r="1.7"/><circle cx="32" cy="6" r="2.4"/><circle cx="52" cy="6" r="1.7"/><circle cx="22" cy="20" r="2"/><circle cx="42" cy="20" r="2"/><path d="M12 6 L32 6 L52 6 M22 20 L32 6 L42 20 M22 20 L42 20" fill="none" stroke-width="0.9" stroke-dasharray="1 2.5"/></g></svg>',
  practice:
    '<svg class="mini" width="64" height="26" viewBox="0 0 64 26"><g fill="currentColor" stroke="currentColor"><circle cx="32" cy="4" r="2.4"/><circle cx="14" cy="22" r="1.8"/><circle cx="50" cy="22" r="1.8"/><circle cx="32" cy="16" r="1.5"/><path d="M14 22 L32 4 L50 22 M32 4 L32 16" fill="none" stroke-width="0.9" stroke-dasharray="1 2.5"/></g></svg>',
};
---

<Base title="Guides on working with AI · CoreWise Academy" faq={faq}>
  <main>
  <div class="hero">
    <canvas
      id="sky"
      aria-label="An interactive star chart of the curriculum: each star is a guide, each line a prerequisite"
    ></canvas>
    <div class="graticule"></div>
    <p class="corner tl">Observatory open<br /><span class="v">free guides</span></p>
    <p class="corner tr">
      Stars <span class="v" data-star-count>·</span> · Links <span class="v" data-link-count>·</span>
    </p>
    <p class="corner bl">Vol. I · MMXXVI<br /><span class="v">Open to all</span></p>
    <div class="hero-copy">
      <h1 class="display">
        <span class="hl"><span>Working with</span></span>
        <span class="hl"
          ><span class="ai"
            >AI<svg
              class="ai-stars"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                class="cline"
                d="M30.5 5 L5 79 M30.5 5 L50 79 M16.5 58 L52.5 58 M30.5 5 L77 5 M77 5 L77 79"
              ></path>
            </svg><i class="cst" style="--x: 30.5%; --y: 5%; --s: 0.085em"></i><i
              class="cst"
              style="--x: 5%; --y: 79%; --s: 0.065em; animation-delay: 0.7s"></i><i
              class="cst"
              style="--x: 50%; --y: 79%; --s: 0.065em; animation-delay: 1.4s"></i><i
              class="cst"
              style="--x: 16.5%; --y: 58%; --s: 0.05em; animation-delay: 2.1s"></i><i
              class="cst"
              style="--x: 52.5%; --y: 58%; --s: 0.05em; animation-delay: 2.8s"></i><i
              class="cst"
              style="--x: 77%; --y: 5%; --s: 0.085em; animation-delay: 1s"></i><i
              class="cst"
              style="--x: 77%; --y: 79%; --s: 0.065em; animation-delay: 1.8s"></i></span
          ></span
        >
        <span class="hl"><span class="lit">Start anywhere</span></span>
      </h1>
      <p class="dek">
        Free library of guides<svg
          class="dek-star"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="M12 0 L14.88 9.12 L24 12 L14.88 14.88 L12 24 L9.12 14.88 L0 12 L9.12 9.12 Z"
          ></path></svg
        >get the most out of AI
      </p>
      <div class="hero-ctas">
        <a class="btn solid" href="#tracks">Browse the layers</a>
        {latest[0] && <a class="btn" href={`/guides/${latest[0].id}/`}>Latest guide</a>}
      </div>
    </div>
    <p class="hero-scroll">↓ scroll</p>
  </div>

  <section id="tracks">
    <div class="sec-head reveal">
      <h2>5 Layers</h2>
      <span class="mono-label">Curriculum chart · Broad → Practitioner → Deep</span>
    </div>

    {
      TRACKS.map((t) => (
        <a class="track reveal" href={`/tracks/${t.slug}/`}>
          <span class="num">{t.numeral}</span>
          <div>
            <h3>{t.name}</h3>
            <span class="constellation">Constellation · {t.constellation}</span>
            <Fragment set:html={minis[t.slug]} />
          </div>
          <p>{t.description}</p>
          <div class="shelves">
            {LEVELS.map((l) => {
              const n = count(t.slug, l.id);
              return (
                <span class={`shelf${n === 0 ? ' empty' : ''}`}>
                  <span>{l.label.toUpperCase()}</span>
                  <span class="stars">
                    {n === 0 ? 'none yet' : `${'★'.repeat(Math.min(n, 5))} ${n} guide${n > 1 ? 's' : ''}`}
                  </span>
                </span>
              );
            })}
          </div>
        </a>
      ))
    }
  </section>

  <section>
    <div class="sec-head reveal">
      <h2>Latest guides</h2>
      <span class="mono-label">Newest first</span>
    </div>
    <div class="charted">
      {
        latest.map((g) => {
          const t = TRACKS.find((x) => x.slug === g.data.track)!;
          return (
            <article class="entry reveal">
              <span class="mono-label accent">
                {t.name} · {g.data.level[0].toUpperCase() + g.data.level.slice(1)}
              </span>
              <h3>
                <a href={`/guides/${g.id}/`}>{g.data.title}</a>
              </h3>
              <p>{g.data.description}</p>
              <span class="foot">
                <span>{g.data.minutes} min</span>
                <span>Nº {String(g.data.number).padStart(3, '0')} · {monthYear(g.data.lastUpdated)}</span>
              </span>
            </article>
          );
        })
      }
      {
        latest.length === 0 && (
          <article class="entry reveal">
            <span class="mono-label accent">Coming soon</span>
            <h3>First guides in progress</h3>
            <p>New guides are being written now.</p>
          </article>
        )
      }
    </div>

    {
      guides.length > 0 && (
        <aside class="plate">
          <i class="plate-rule" aria-hidden="true"></i>

          <p class="plate-head">
            <span>Chart of the catalogue</span>
            <span>One star for every guide</span>
          </p>

          <div class="plate-body">
            <div class="plate-type reveal">
              <h2>Every guide on one page</h2>
              <p class="plate-go">
                <a class="btn" href="/guides/">
                  Every Guide <span class="arw" aria-hidden="true">&#8594;</span>
                </a>
              </p>
            </div>

            <div class="plate-figure reveal">
              <svg viewBox={`0 0 ${PLATE_W} ${PLATE_H}`} aria-hidden="true" focusable="false">
                <path
                  class="pl-boundary"
                  d={`M 0 ${PLATE_H - 34} C 250 ${PLATE_H - 78} 560 ${PLATE_H - 150} ${PLATE_W} ${PLATE_H - 254}`}
                ></path>

                <g class="pl-field">
                  {plateField.map((s) => <circle cx={s.x} cy={s.y} r={s.r} style={`opacity:${s.o}`} />)}
                </g>

                <path class="pl-spine" d={plateSpine} style={`--len:${plateSpineLen}`}></path>

                <g class="pl-rings">
                  {
                    PLATE_RINGS.map((r, i) => (
                      <g>
                        <circle cx={r.cx} cy={r.cy} r="7" />
                        <text x={r.cx} y={r.cy + 27}>{TRACKS[i]?.numeral ?? ''}</text>
                      </g>
                    ))
                  }
                </g>

                {
                  plateLit.map((s) => (
                    <g class="pl-lit">
                      <path class="pl-spur" d={`M ${s.rx} ${s.ry} L ${s.x} ${s.y}`} />
                      <circle class="pl-halo" cx={s.x} cy={s.y} r="17" />
                      <path class="pl-star" d={PLATE_STAR_D} transform={plateStarAt(s.x, s.y, 22)} style={`animation-delay:${s.delay}`} />
                      <path class="pl-lead" d={`M ${s.x + s.dir * 22} ${s.y} L ${s.x + s.dir * 32} ${s.y}`} />
                      <text class="pl-name" x={s.x + s.dir * 40} y={s.y} text-anchor={s.anchor}>{s.label}</text>
                    </g>
                  ))
                }
              </svg>
            </div>
          </div>

          <i class="plate-rule foot" aria-hidden="true"></i>
        </aside>
      )
    }
  </section>

  <section class="ledger">
    <div class="sec-head reveal">
      <h2>The catalogue at a glance</h2>
      <span class="mono-label">Working with AI · five layers · three depths</span>
    </div>
    <div class="ledger-grid reveal">
      <div class="ledger-table">
        <table class="curriculum">
          <thead>
            <tr><th>Layer</th><th>Constellation</th><th>Guides</th><th>Topics</th></tr>
          </thead>
          <tbody>
            {
              TRACKS.map((t) => (
                <tr>
                  <td><a href={`/tracks/${t.slug}/`}>{t.name}</a></td>
                  <td class="mono">{t.constellation}</td>
                  <td class="mono">{trackCount(t.slug)}</td>
                  <td class="tags-cell">
                    <span class="chips">
                      {trackTopTags(t.slug).map((tag) => (
                        <a class="tag-chip" href={`/tags/${tag.slug}/`}>{tag.display}</a>
                      ))}
                    </span>
                  </td>
                </tr>
              ))
            }
            <tr class="total">
              <td colspan="4">
                <a class="catalogue-cta" href="/guides/">
                  <span>Browse the whole catalogue</span>
                  <span class="mono">{guides.length} guides · {TAGS.length} topics →</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="margin-notes" data-quotes>
        <span class="panel-label">Quotes from the guides</span>
        {
          seedQuotes.map((q) => (
            <blockquote>
              <p>“{q.quote}”</p>
              <cite>
                <a href={q.href}>{q.title}</a>
              </cite>
            </blockquote>
          ))
        }
      </div>
    </div>
    <script id="quote-pool" type="application/json" is:inline set:html={quotePoolJson} />
    <script is:inline>
      // Runs where it sits, before the panel paints: no flash of the rendered three.
      (() => {
        const panel = document.querySelector('[data-quotes]');
        const pool = JSON.parse(document.getElementById('quote-pool').textContent);
        const slots = panel ? panel.querySelectorAll('blockquote') : [];
        if (pool.length < slots.length) return;
        for (let i = pool.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [pool[i], pool[j]] = [pool[j], pool[i]];
        }
        slots.forEach((slot, i) => {
          const link = slot.querySelector('cite a');
          slot.querySelector('p').textContent = '“' + pool[i].quote + '”';
          link.textContent = pool[i].title;
          link.href = pool[i].href;
        });
      })();
    </script>
    <div class="reveal">
      <Faq heading="FAQ · working with the Academy" items={faq} />
    </div>
  </section>

  <div class="enrol">
    <div class="enrol-inner">
      <div class="reveal">
        <p class="mono-label">Free · no signup</p>
        <h2>Start anywhere, anytime</h2>
        <p>
          No accounts, no fees, no forms. Pick a layer and start reading.
        </p>
        <p style="margin-top: var(--s-4)"><a class="btn" href="#tracks">Start with Foundations</a></p>
      </div>
      <svg class="stamp reveal" width="230" height="230" viewBox="0 0 230 230" aria-hidden="true">
        <defs><path id="arcT" d="M 115 30 A 85 85 0 1 1 114.9 30"></path></defs>
        <circle cx="115" cy="115" r="108" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.9"></circle>
        <circle cx="115" cy="115" r="98" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6" stroke-dasharray="3 5"></circle>
        <text font-family="IBM Plex Mono, monospace" font-size="12.5" letter-spacing="3.2" fill="currentColor" opacity="0.9">
          <textPath href="#arcT">COREWISE ACADEMY · COLLEGE OF APPLIED MINDS</textPath>
        </text>
        <g stroke="currentColor" fill="currentColor">
          <circle cx="86" cy="108" r="3.4"></circle><circle cx="115" cy="88" r="4.6"></circle>
          <circle cx="146" cy="112" r="3.4"></circle><circle cx="103" cy="138" r="2.6"></circle>
          <circle cx="134" cy="142" r="3"></circle>
          <path d="M86 108 L115 88 L146 112 M103 138 L115 88 M134 142 L146 112" fill="none" stroke-width="1.2" opacity="0.75"></path>
        </g>
        <text x="115" y="180" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="3" fill="currentColor">ADMITTED</text>
        <text x="115" y="196" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="8.5" letter-spacing="2" fill="currentColor" opacity="0.7">COHORT MMXXVI</text>
      </svg>
    </div>
  </div>

  </main>

  <script>
    import '../scripts/hero.js';
  </script>

  <style>
    .hero { position: relative; min-height: max(100vh, 680px); overflow: hidden; }
    #sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    .graticule {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        repeating-linear-gradient(to right, var(--line-soft) 0 1px, transparent 1px 12.5%),
        repeating-linear-gradient(to bottom, var(--line-soft) 0 1px, transparent 1px 25%);
      mask-image: radial-gradient(ellipse 90% 80% at 50% 45%, black 30%, transparent 78%);
    }
    .hero-copy {
      position: relative;
      z-index: 2;
      min-height: max(100vh, 680px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem var(--s-4) 14rem;
      max-width: 70rem;
      margin: 0 auto;
      pointer-events: none;
    }
    .hero-copy > :global(*) { pointer-events: auto; width: fit-content; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 7vw, 4.1rem);
      line-height: 1.02;
      letter-spacing: 0.005em;
      max-width: 12ch;
    }
    .hero h1 .hl { display: block; overflow: hidden; }
    .hero h1 .hl > span { display: block; transform: translateY(110%); animation: rise 0.9s var(--ease) forwards; }
    .hero h1 .hl:nth-child(2) > span { animation-delay: 0.12s; }
    .hero h1 .hl:nth-child(3) > span { animation-delay: 0.24s; }
    @keyframes rise { to { transform: none; } }
    .hero h1 .lit { color: var(--accent-deep); text-shadow: 0 0 24px var(--glow); }
    .hero h1 .ai {
      position: relative;
      width: fit-content;
      font-size: 1.8em;
      line-height: 1;
      padding-right: 0.1em;
      background: linear-gradient(
        105deg,
        var(--ink) 0%,
        var(--accent-deep) 30%,
        color-mix(in srgb, var(--accent) 55%, var(--paper)) 50%,
        var(--accent) 62%,
        var(--accent-deep) 78%,
        var(--ink) 100%
      );
      background-size: 220% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 34px var(--glow);
      animation:
        rise 0.9s var(--ease) forwards,
        ink-drift 8s ease-in-out 1.1s infinite alternate;
    }
    @keyframes ink-drift {
      from { background-position: 0% 0; }
      to { background-position: 100% 0; }
    }
    .ai-stars {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
    }
    .ai-stars .cline {
      fill: none;
      stroke: var(--star-dim);
      stroke-width: 1;
      stroke-dasharray: 3 5;
      vector-effect: non-scaling-stroke;
    }
    .hero h1 .ai .cst {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--s);
      height: var(--s);
      transform: translate(-50%, -50%);
      background: var(--star);
      clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
      filter: drop-shadow(0 0 4px var(--glow));
      animation: twinkle 3.2s var(--ease) infinite alternate;
    }
    @keyframes twinkle {
      from { opacity: 0.35; }
      to { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero h1 .ai { animation: rise 0.9s var(--ease) forwards; }
      .hero h1 .ai .cst { animation: none; opacity: 0.85; }
    }
    .hero .dek, .hero-ctas { animation: fadein 1s var(--ease) both; }
    .hero .dek { animation-delay: 0.35s; }
    .hero-ctas { animation-delay: 0.5s; }
    @keyframes fadein { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    .hero .dek { font-size: var(--text-md); font-style: italic; color: var(--ink-soft); max-width: 44ch; margin-top: var(--s-2); }
    .dek-star {
      display: inline-block;
      width: 0.7em;
      height: 0.7em;
      margin: 0 0.4em;
      vertical-align: -0.04em;
      fill: var(--star);
      filter: drop-shadow(0 0 4px var(--glow));
      transform-origin: 50% 50%;
      animation: twinkle 3.2s var(--ease) infinite alternate, dek-star-spin 14s linear infinite;
    }
    @keyframes dek-star-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .dek-star { animation: none; opacity: 0.9; }
    }
    .hero-ctas { display: flex; gap: var(--s-3); margin-top: var(--s-4); }
    .corner {
      position: absolute;
      z-index: 2;
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--ink-mute);
    }
    .corner.tl { top: 1.75rem; left: var(--s-4); }
    .corner.tr { top: 1.75rem; right: var(--s-4); text-align: right; }
    .corner.bl { bottom: var(--s-3); left: var(--s-4); }
    .corner .v { color: var(--accent-deep); }
    .hero-scroll {
      position: absolute;
      bottom: var(--s-3);
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      color: var(--ink-mute);
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      animation: bob 2.6s var(--ease) infinite;
    }
    @keyframes bob {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 6px); }
    }

    section { max-width: 70rem; margin: 0 auto; padding: var(--s-12) var(--s-4); }
    /* wrap so the label drops under the heading instead of off a 320px screen */
    .sec-head { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--ink); padding-bottom: var(--s-2); }
    .sec-head h2 { font-family: var(--font-display); font-size: var(--text-2xl); }
    .sec-head .mono-label { color: var(--ink-mute); }

    .track {
      display: grid;
      grid-template-columns: 5.3rem 1.2fr 1.6fr 20rem;
      gap: var(--s-3);
      align-items: start;
      padding: var(--s-4) 0;
      border-bottom: 1px solid var(--line);
      transition: background var(--dur) var(--ease);
      text-decoration: none;
      color: inherit;
      position: relative;
    }
    /* Hover wash feathers out at the left and right edges instead of ending in a hard rectangle. */
    .track::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 0%, var(--accent-wash) 14%, var(--accent-wash) 86%, transparent 100%);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
      pointer-events: none;
      z-index: 0;
    }
    .track > * { position: relative; z-index: 1; }
    .track:hover::before { opacity: 1; }
    .track .num { font-family: var(--font-display); font-size: var(--text-xl); color: var(--accent-deep); }
    .track h3 { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; }
    .track :global(.mini) { color: var(--accent-deep); opacity: 0.85; display: block; margin-top: 10px; }
    .track .constellation {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      color: var(--ink-mute);
      display: block;
      margin-top: 4px;
    }
    .track p { color: var(--ink-soft); font-size: var(--text-sm); max-width: 46ch; }
    .shelves { display: grid; gap: 6px; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em; }
    .shelf { display: flex; justify-content: space-between; gap: var(--s-2); border-bottom: 1px dashed var(--line); padding-bottom: 4px; color: var(--ink-soft); }
    .shelf .stars { color: var(--accent-deep); }
    .shelf.empty .stars { color: var(--ink-mute); font-style: italic; }

    /* ---- the plate of the catalogue -----------------------------------------
       The hero is the live sky. This is the printed page about it: a graduated
       rule top and bottom instead of a frame, one figure struck across the field,
       and a written key. Hairlines and type only, no fills, no box. */
    .plate { margin-top: var(--s-8); }

    /* graduated scale rules: a hairline with minor ticks every 2.4rem and a
       longer tick every 12rem, the way a chart graduates its coordinate edge */
    .plate-rule {
      display: block;
      height: 12px;
      border-top: 1px solid var(--line);
      background-image:
    repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 2.4rem),
    repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 12rem);
      background-size: 100% 5px, 100% 11px;
      background-repeat: no-repeat;
      background-position: left top, left top;
    }
    .plate-rule.foot {
      border-top: 0;
      border-bottom: 1px solid var(--line);
      background-position: left bottom, left bottom;
    }

    .plate-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--s-1) var(--s-3);
      padding-top: var(--s-1);
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }

    .plate-body {
      display: grid;
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: var(--s-6);
      align-items: center;
      padding: var(--s-4) 0 var(--s-3);
    }

    .plate-type h2 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: var(--text-xl);
      line-height: var(--leading-tight);
      color: var(--ink);
    }
    .plate-type > p { margin-top: var(--s-3); color: var(--ink-soft); font-size: var(--text-sm); }
    .plate-go { margin-top: var(--s-4); }
    .plate-go .arw { display: inline-block; transition: transform var(--dur) var(--ease); }
    .plate-go .btn:hover .arw,
    .plate-go .btn:focus-visible .arw { transform: translateX(4px); }
    .plate-go .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    /* the drawing. Capped at roughly its own scale so the engraved labels never
       balloon on an ultrawide or shrink to nothing at the stacking width */
    .plate-figure svg {
      display: block;
      width: 100%;
      max-width: 44rem;
      height: auto;
      margin: 0 auto;
      overflow: visible;
    }

    .pl-boundary { fill: none; stroke: var(--line-soft); stroke-width: 1.4; stroke-dasharray: 1 7; }

    .pl-field circle { fill: var(--star-dim); transition: fill var(--dur) var(--ease); }
    .plate:hover .pl-field circle,
    .plate:focus-within .pl-field circle { fill: var(--star); }

    .pl-spine {
      fill: none;
      stroke: var(--accent);
      stroke-opacity: 0.55;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: var(--len);
      stroke-dashoffset: var(--len);
      transition: stroke-opacity var(--dur) var(--ease);
    }
    .plate:hover .pl-spine,
    .plate:focus-within .pl-spine { stroke-opacity: 0.85; }
    /* the figure is struck once, when the block arrives */
    .plate-figure.in .pl-spine { animation: plate-draw 1.6s var(--ease) 0.1s forwards; }
    @keyframes plate-draw { to { stroke-dashoffset: 0; } }

    .pl-rings circle { fill: none; stroke: var(--ink-mute); stroke-width: 1.4; }
    .pl-rings text {
      font-family: var(--font-mono);
      font-size: 17px;
      letter-spacing: 0.14em;
      fill: var(--ink-mute);
      text-anchor: middle;
    }

    /* the called-out three arrive after the figure line has been laid down */
    .pl-lit { opacity: 0; }
    .plate-figure.in .pl-lit { animation: plate-fade 0.9s var(--ease) 1.1s both; }
    @keyframes plate-fade { from { opacity: 0; } to { opacity: 1; } }

    .pl-spur { fill: none; stroke: var(--line); stroke-width: 1.2; stroke-dasharray: 2 5; }
    .pl-halo { fill: none; stroke: var(--accent); stroke-opacity: 0.3; stroke-width: 1; }
    .pl-lead { fill: none; stroke: var(--ink-mute); stroke-width: 1; }
    .pl-star { fill: var(--star); filter: drop-shadow(0 0 5px var(--glow)); }
    /* three separate stars, so they breathe out of step: in step they read as one
       control, out of step they read as sky. Floors well above the hero twinkle so
       a labelled star never blinks out from under its own name. */
    .plate-figure.in .pl-star { animation: plate-twinkle 4.6s var(--ease) infinite alternate; }
    @keyframes plate-twinkle { from { opacity: 0.62; } to { opacity: 1; } }
    .pl-name {
      font-family: var(--font-mono);
      font-size: 17px;
      letter-spacing: 0.1em;
      fill: var(--accent-deep);
      dominant-baseline: central;
    }


    @media (max-width: 1240px) {
      .plate-body {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-3) 0;
      }
      .pl-rings text, .pl-name { font-size: 15px; }
    }
    @media (max-width: 900px) {
      .plate-type h2 { font-size: var(--text-lg); }
      .plate-rule { height: 9px; background-size: 100% 4px, 100% 9px; }
      /* .btn is nowrap sitewide and would push through the plate on a narrow phone */
      .plate-go .btn { white-space: normal; min-width: 0; }
    }
    @media (max-width: 620px) {
      /* at phone width the plate is too small to letter, so it shows the figure
     and lets the key below carry the naming */
      .pl-rings text, .pl-name, .pl-lead { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .plate-figure .pl-spine, .plate-figure.in .pl-spine { animation: none; stroke-dashoffset: 0; }
      .plate-figure .pl-lit, .plate-figure.in .pl-lit { animation: none; opacity: 1; }
      .plate-figure .pl-star, .plate-figure.in .pl-star { animation: none; opacity: 1; }
      .plate-go .arw { transition: none; }
    }
    /* .reveal starts at opacity 0 and needs JS to clear it */
    @media (scripting: none) {
      .plate .reveal { opacity: 1; transform: none; }
      .plate-figure .pl-spine { stroke-dashoffset: 0; }
      .plate-figure .pl-lit { opacity: 1; }
    }
    /* editor: the catalogue link is the loud element in this block */
    .plate-go .btn {
      font-size: var(--text-sm);
      padding: 18px 34px;
      letter-spacing: 0.16em;
    }
    .plate-go .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

    .charted { display: grid; grid-template-columns: repeat(3, 1fr); border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
    .entry {
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: var(--s-4);
      position: relative;
      transition: background var(--dur) var(--ease);
      min-height: 14rem;
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }
    .entry:hover { background: var(--accent-wash); }
    .entry .mono-label { margin-bottom: var(--s-2); }
    .entry h3 { font-family: var(--font-display); font-size: var(--text-md); font-weight: 400; line-height: 1.15; margin-bottom: var(--s-2); }
    .entry h3 a { color: var(--ink); text-decoration: none; }
    /* Stretch the title link to cover the whole card so a click anywhere opens the guide. */
    .entry h3 a::after { content: ''; position: absolute; inset: 0; }
    .entry:hover h3 a { color: var(--accent-deep); }
    .entry p { font-size: var(--text-sm); color: var(--ink-soft); flex: 1; }
    .entry .foot { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-mute); margin-top: var(--s-3); display: flex; justify-content: space-between; }
    .ledger-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--s-6); margin-top: var(--s-4); }
    .curriculum { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
    .curriculum th {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--ink-mute);
      text-align: left;
      border-bottom: 1px solid var(--ink);
      padding: var(--s-1) var(--s-2) var(--s-1) 0;
    }
    .curriculum td { border-bottom: 1px dashed var(--line); padding: var(--s-2) var(--s-2) var(--s-2) 0; }
    .curriculum td a { color: var(--ink); text-decoration: none; border-bottom: 1px dashed var(--accent); }
    .curriculum td a:hover { color: var(--accent-deep); }
    .curriculum .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-soft); }
    .curriculum .total td { border-bottom: none; border-top: 1px solid var(--ink); font-weight: 600; }
    .curriculum td a.catalogue-cta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--s-3);
      border-bottom: none;
      color: var(--accent-deep);
      transition: color var(--dur) var(--ease);
    }
    .curriculum td a.catalogue-cta:hover { color: var(--ink); }
    .curriculum td a.catalogue-cta .mono { font-weight: 400; }
    .curriculum .chips { display: flex; flex-wrap: wrap; gap: 5px; }
    .curriculum td a.tag-chip {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      color: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 1px 9px;
      white-space: nowrap;
      transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
    }
    .curriculum td a.tag-chip:hover { color: var(--accent-deep); border-color: var(--accent-deep); }
    .margin-notes blockquote { margin: 0 0 var(--s-3); padding-left: var(--s-3); border-left: 3px solid var(--accent-deep); }
    .margin-notes blockquote p { font-style: italic; font-size: var(--text-md); line-height: 1.3; }
    .margin-notes cite { font-family: var(--font-mono); font-size: var(--text-2xs); font-style: normal; color: var(--ink-mute); }
    .margin-notes cite a { color: var(--ink-soft); }
    .enrol { background: var(--ink); color: var(--paper); padding: var(--s-12) var(--s-4); position: relative; overflow: hidden; }
    .enrol-inner { max-width: 70rem; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s-8); align-items: center; }
    .enrol h2 { font-family: var(--font-display); font-size: var(--text-2xl); margin-bottom: var(--s-3); }
    .enrol p { color: color-mix(in srgb, var(--paper) 75%, transparent); max-width: 50ch; }
    .enrol .mono-label { color: color-mix(in srgb, var(--paper) 55%, transparent); }
    .enrol .btn { border-color: var(--paper); color: var(--paper); }
    .enrol .btn:hover { background: var(--paper); color: var(--ink); }
    .stamp { justify-self: center; transform: rotate(-7deg); }

    @media (max-width: 900px) {
      .track { grid-template-columns: 56px 1fr; }
      .shelves, .track p { grid-column: 2; }
      .charted { grid-template-columns: 1fr; }
      .ledger-grid { grid-template-columns: 1fr; }
      .enrol-inner { grid-template-columns: 1fr; }
      .corner.tr { display: none; }
      .shelf { font-size: 10px; letter-spacing: 0.03em; }
      .hero-ctas { flex-wrap: wrap; }
      /* the key lies down beside its caption instead of standing in the margin */
      .plate { padding: var(--s-3); }
      .plate-body { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); padding: var(--s-3) 0; }
      .plate-type { grid-column: 1; grid-row: auto; }
      .plate-type h2 { font-size: var(--text-lg); }
      /* .btn is nowrap sitewide, which pushes it through the plate frame on a
         narrow phone; inside the plate the label may wrap instead */
      .plate-go .btn { white-space: normal; min-width: 0; }
    }
    @media (max-width: 620px) {
      /* A tag chip cannot wrap, so the topics column sets a min-content width the
         table will not shrink below, and the page scrolls sideways. The
         constellation name is the one column carrying no information the rest of
         the row lacks, so it stands down first, and the table keeps its own
         scroll container so the page body can never scroll at any width. */
      .curriculum th:nth-child(2), .curriculum td:nth-child(2) { display: none; }
      .ledger-table { overflow-x: auto; }
    }
    @media (max-width: 460px) {
      /* the crosses sit outside the frame; keep them off the viewport edge */
      .plate .rx { display: none; }
    }
  </style>
