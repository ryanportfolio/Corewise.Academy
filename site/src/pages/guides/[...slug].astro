---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { trackBySlug, LEVELS } from '../../data/tracks';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.status === 'published')
    .map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const d = guide.data;
const track = trackBySlug(d.track)!;
const level = LEVELS.find((l) => l.id === d.level)!;
const allGuides = await getCollection('guides');
const prereqs = d.prerequisites.map((p) => {
  const target = allGuides.find((g) => g.id === p.slug);
  return { ...p, target };
});
const no = String(d.number).padStart(3, '0');
const isoDate = d.lastUpdated.toISOString().slice(0, 10);
---

<Base
  title={`${d.title} · CoreWise Academy`}
  description={d.description}
  faq={d.selfCheck}
  datePublished={isoDate}
  dateModified={isoDate}
  crumbs={[
    { name: `${track.name} track`, path: `/tracks/${track.slug}/` },
    { name: d.title, path: `/guides/${guide.id}/` },
  ]}
>
  <div class="ambient"></div>
  <div class="twinkle" style="top:18%; left:6%; animation-delay:0s"></div>
  <div class="twinkle" style="top:42%; left:9%; animation-delay:2.2s"></div>
  <div class="twinkle" style="top:66%; left:5%; animation-delay:4.4s"></div>
  <div class="twinkle" style="top:30%; right:7%; animation-delay:1.1s"></div>
  <div class="twinkle" style="top:58%; right:5%; animation-delay:3.3s"></div>
  <div class="twinkle" style="top:80%; right:9%; animation-delay:5.5s"></div>

  <div class="progress-track" aria-hidden="true">
    <svg class="progress-star" id="pstar" viewBox="0 0 12 12">
      <path d="M6 0 L7.4 4.6 L12 6 L7.4 7.4 L6 12 L4.6 7.4 L0 6 L4.6 4.6 Z" fill="currentColor"></path>
    </svg>
  </div>

  <article>
    <p class="kicker mono-label accent">
      {track.name} · Track {track.numeral}
      <span class="lvl">/ {level.label}</span>
    </p>
    <h1 class="display">{d.title}</h1>
    <p class="dek">{d.description}</p>
    <p class="byline">
      <span>Nº {no} · Vol. I</span><span>·</span><span>{d.minutes} min read</span><span>·</span>
      <span>Updated {d.lastUpdated.toLocaleString('en', { month: 'long', year: 'numeric' })}</span>
    </p>

    <aside class="objectives">
      <span class="panel-label">After this guide, you can</span>
      <ul>
        {d.objectives.map((o) => <li set:html={o.replace(/^(\w+)/, '<b>$1</b>')} />)}
      </ul>
    </aside>

    {
      prereqs.length > 0 && (
        <div class="prereqs">
          <svg width="108" height="48" viewBox="0 0 108 48" aria-hidden="true">
            <g fill="currentColor" stroke="currentColor">
              <circle cx="10" cy="36" r="3" />
              <circle cx="38" cy="14" r="3" />
              <path d="M10 36 L38 14 L74 26" fill="none" stroke-width="1" stroke-dasharray="2 3" />
              <path d="M74 26 l1.7 5.6 5.6 1.7 -5.6 1.7 -1.7 5.6 -1.7 -5.6 -5.6 -1.7 5.6 -1.7 Z" stroke="none" />
              <text x="70" y="10" text-anchor="middle" font-family="IBM Plex Mono" font-size="7" letter-spacing="1" stroke="none">
                YOU ARE HERE
              </text>
            </g>
          </svg>
          <span>
            <span class="panel-label inline">Read first</span>&ensp;
            {prereqs.map((p, i) => (
              <>
                {p.target ? <a href={`/guides/${p.target.id}/`}>{p.target.data.title}</a> : p.slug}
                {p.note && ` (${p.note})`}
                {i < prereqs.length - 1 && ' · '}
              </>
            ))}
          </span>
        </div>
      )
    }

    <div class="body-text">
      <Content />
    </div>

    <Faq heading="FAQ · check yourself" items={d.selfCheck} />

    <section class="sources">
      <span class="panel-label">Sources</span>
      {
        d.sources.length > 0 ? (
          <ol>
            {d.sources.map((s) => (
              <li>
                <span class="creator">{s.creator}</span> · <a href={s.url}>“{s.video}”</a>
                <br />
                <span class="stamps">
                  cited at {s.timestamps.join(' · ')} · watched {s.watched}
                </span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="original-note">Original work by the editor, no video source.</p>
        )
      }
    </section>
  </article>

  <script>
    // the reading star ascends as you read
    const star = document.getElementById('pstar')!;
    const track = document.querySelector('.progress-track')! as HTMLElement;
    addEventListener(
      'scroll',
      () => {
        const p = scrollY / (document.body.scrollHeight - innerHeight);
        star.style.top = `${Math.min(0.99, Math.max(0, p)) * (track.clientHeight - 12)}px`;
      },
      { passive: true },
    );
  </script>

  <style>
    .ambient {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        repeating-linear-gradient(to right, var(--line-soft) 0 1px, transparent 1px 160px),
        repeating-linear-gradient(to bottom, var(--line-soft) 0 1px, transparent 1px 160px);
      mask-image: linear-gradient(to right, black 0 18%, transparent 30% 70%, black 82% 100%);
    }
    .twinkle {
      position: fixed;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--star);
      opacity: 0;
      pointer-events: none;
      z-index: 0;
      animation: twk 7s var(--ease) infinite;
      box-shadow: 0 0 10px var(--glow);
    }
    @keyframes twk {
      0%, 100% { opacity: 0; transform: scale(0.5); }
      50% { opacity: 0.7; transform: scale(1); }
    }

    .progress-track { position: fixed; left: 26px; top: 90px; bottom: 40px; width: 1px; background: var(--line); z-index: 40; }
    .progress-star { position: absolute; left: -5.5px; top: 0; width: 12px; height: 12px; color: var(--accent-deep); filter: drop-shadow(0 0 6px var(--glow)); transition: top 0.2s linear; }

    article { position: relative; z-index: 1; max-width: calc(var(--measure) + 2 * var(--s-4)); margin: 0 auto; padding: var(--s-8) var(--s-4) var(--s-12); }

    .kicker { display: flex; gap: var(--s-1); align-items: center; color: var(--accent-deep); }
    .kicker .lvl { color: var(--ink-mute); }
    /* Cap sized so the longest guide title (41 chars) stays on one line at the article measure */
    h1 { font-family: var(--font-display); font-size: clamp(1.4rem, 3.6vw, 1.85rem); line-height: 1.08; margin: var(--s-2) 0; text-wrap: balance; }
    .dek { font-size: var(--text-md); font-style: italic; color: var(--ink-soft); }
    .byline {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--ink-mute);
      letter-spacing: 0.05em;
      display: flex;
      gap: var(--s-2);
      flex-wrap: wrap;
      align-items: center;
      padding: var(--s-3) 0 var(--s-4);
      border-bottom: 1px solid var(--line);
      margin-bottom: var(--s-4);
    }

    .objectives { border: 1px solid var(--line); border-top: 3px solid var(--accent-deep); background: var(--panel); padding: var(--s-3); margin: var(--s-4) 0; }
    .objectives ul { list-style: none; padding: 0; margin: 0; }
    .objectives li { padding-left: var(--s-3); position: relative; margin-bottom: var(--s-1); }
    .objectives li::before { content: '✦'; position: absolute; left: 0; color: var(--accent-deep); font-size: 0.8em; top: 0.25em; }
    .objectives li :global(b) { color: var(--accent-deep); }

    .prereqs { display: flex; gap: var(--s-3); align-items: center; margin: var(--s-3) 0 var(--s-6); font-size: var(--text-sm); color: var(--ink-soft); }
    .prereqs svg { flex: 0 0 auto; color: var(--accent-deep); }
    .panel-label.inline { display: inline; margin: 0; color: var(--ink-mute); }

    .body-text { position: relative; }
    .body-text :global(p) { margin-bottom: var(--s-3); }
    .body-text > :global(p:first-of-type)::first-letter,
    .body-text :global(.lede)::first-letter {
      font-family: var(--font-display);
      font-size: 3.4em;
      line-height: 0.82;
      float: left;
      padding: 0.1em 0.14em 0 0;
      color: var(--accent-deep);
    }
    .body-text :global(h2) {
      font-family: var(--font-body);
      font-size: var(--text-xl);
      font-weight: 600;
      margin: var(--s-6) 0 var(--s-2);
    }
    .body-text :global(h2 .sec-no) { color: var(--accent-deep); margin-right: 0.45em; }
    .body-text :global(ul) { margin: 0 0 var(--s-3) var(--s-3); }
    .body-text :global(li) { margin-bottom: var(--s-1); }
    .body-text :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--accent-wash); padding: 1px 5px; }
    .body-text :global(blockquote) {
      margin: var(--s-4) 0;
      padding-left: var(--s-3);
      border-left: 3px solid var(--accent-deep);
      font-style: italic;
      font-size: var(--text-md);
      color: var(--ink-soft);
    }
    .body-text :global(table) { border-collapse: collapse; font-size: var(--text-sm); margin: var(--s-3) 0; width: 100%; }
    .body-text :global(th) {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--ink-mute);
      text-align: left;
      border-bottom: 1px solid var(--ink);
      padding: var(--s-1) var(--s-3) var(--s-1) 0;
    }
    .body-text :global(td) { border-bottom: 1px dashed var(--line); padding: var(--s-2) var(--s-3) var(--s-2) 0; vertical-align: top; }

    .sources { margin-top: var(--s-8); padding-top: var(--s-4); border-top: 3px double var(--line); }
    .sources ol { margin: 0 0 0 var(--s-3); font-size: var(--text-sm); }
    .sources li { margin-bottom: var(--s-2); }
    .sources .creator { font-weight: 600; }
    .sources .stamps { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-mute); }
    .sources .original-note { font-size: var(--text-sm); font-style: italic; color: var(--ink-soft); }
  </style>
</Base>
