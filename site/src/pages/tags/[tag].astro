---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TRACKS } from '../../data/tracks';
import { TAGS } from '../../data/tags';

export function getStaticPaths() {
  return TAGS.map((t) => ({ params: { tag: t.slug }, props: { tag: t } }));
}

const { tag } = Astro.props;
const guides = (await getCollection('guides'))
  .filter((g) => g.data.status === 'published' && g.data.tags.includes(tag.label))
  .sort((a, b) => a.data.number - b.data.number);
const trackName = (slug: string) => TRACKS.find((t) => t.slug === slug)?.name ?? slug;
const levelLabel = (level: string) => level.charAt(0).toUpperCase() + level.slice(1);
---

<Base
  title={`Guides about ${tag.display} · CoreWise Academy`}
  description={`Every guide in the catalogue tagged ${tag.display}.`}
  crumbs={[{ name: `Tag · ${tag.display}`, path: `/tags/${tag.slug}/` }]}
>
  <main>
    <header class="tag-head">
      <p class="mono-label accent">Topic tag</p>
      <h1 class="display">{tag.display}</h1>
      <p class="dek">
        {guides.length} guide{guides.length === 1 ? '' : 's'} in the catalogue cover this topic.
      </p>
    </header>

    <p class="all-tags top">
      <span class="all-tags-label">All topics:</span>
      {TAGS.map((t) => <a href={`/tags/${t.slug}/`} class:list={[{ here: t.slug === tag.slug }]}>{t.display}</a>)}
    </p>

    <ol class="shelf-list">
      {
        guides.map((g) => (
          <li class="reveal">
            <a href={`/guides/${g.id}/`}>
              <span class="no">Nº {String(g.data.number).padStart(3, '0')}</span>
              <span class="t">{g.data.title}</span>
              <span class="m">{trackName(g.data.track)} · {levelLabel(g.data.level)}</span>
              <p>{g.data.description}</p>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="all-tags reveal">
      <span class="all-tags-label">All topics:</span>
      {TAGS.map((t) => <a href={`/tags/${t.slug}/`} class:list={[{ here: t.slug === tag.slug }]}>{t.display}</a>)}
    </p>
  </main>

  <style>
    main { max-width: 70rem; margin: 0 auto; padding: var(--s-8) var(--s-4) var(--s-12); }
    .tag-head { padding-bottom: var(--s-4); border-bottom: 1px solid var(--ink); }
    h1 { font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, var(--text-3xl)); margin: var(--s-2) 0; }
    .dek { font-size: var(--text-md); font-style: italic; color: var(--ink-soft); max-width: 52ch; }

    .shelf-list { list-style: none; margin: 0 0 var(--s-8); padding: 0; }
    .shelf-list li { border-bottom: 1px dashed var(--line); position: relative; }
    .shelf-list a {
      display: grid;
      grid-template-columns: 6.5rem 1fr auto;
      gap: 4px var(--s-3);
      text-decoration: none;
      color: var(--ink);
      align-items: baseline;
      position: relative;
      padding: var(--s-2) 0;
      transition: background var(--dur) var(--ease);
    }
    /* hover wash feathers out at the left and right edges instead of ending in a hard rectangle */
    .shelf-list a::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 0%, var(--accent-wash) 14%, var(--accent-wash) 86%, transparent 100%);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
      pointer-events: none;
      z-index: 0;
    }
    .shelf-list a > * { position: relative; z-index: 1; }
    /* the constellation edge: an accent line draws itself along the divider on hover */
    .shelf-list a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background: repeating-linear-gradient(to right, var(--accent) 0 5px, transparent 5px 11px);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur) var(--ease);
    }
    .shelf-list .no { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent-deep); }
    /* the star that ignites: hidden until the row is sighted */
    .shelf-list .no::before {
      content: '✦';
      display: inline-block;
      margin-right: 0.55em;
      color: var(--accent);
      opacity: 0;
      transform: scale(0.3) rotate(-120deg);
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), text-shadow var(--dur) var(--ease);
    }
    .shelf-list .t {
      font-family: var(--font-display);
      font-size: var(--text-md);
      background: linear-gradient(currentColor, currentColor) no-repeat left 92% / 0% 1px;
      transition: color var(--dur) var(--ease), background-size var(--dur) var(--ease), text-shadow var(--dur) var(--ease);
    }
    .shelf-list .m { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-mute); transition: color var(--dur) var(--ease); }
    .shelf-list p { grid-column: 2; margin: 0; padding-left: var(--s-3); font-size: var(--text-sm); color: var(--ink-soft); max-width: 52ch; }
    .shelf-list a:hover::before, .shelf-list a:focus-visible::before { opacity: 1; }
    .shelf-list a:hover::after, .shelf-list a:focus-visible::after { transform: scaleX(1); }
    .shelf-list a:hover .no::before, .shelf-list a:focus-visible .no::before {
      opacity: 1;
      transform: none;
      text-shadow: 0 0 14px var(--glow);
    }
    .shelf-list a:hover .t, .shelf-list a:focus-visible .t {
      color: var(--accent-deep);
      background-size: 100% 1px;
      text-shadow: 0 0 20px var(--glow);
    }
    .shelf-list a:hover .m, .shelf-list a:focus-visible .m { color: var(--accent-deep); }

    .all-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      font-size: var(--text-sm);
      color: var(--ink-mute);
    }
    /* the same chip row sits above the list so the neighbouring topics are reachable without scrolling past it */
    .all-tags.top { margin: var(--s-4) 0 var(--s-5); }
    .all-tags-label { margin-right: 4px; }
    .all-tags a {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      color: var(--ink-soft);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 1px 9px;
      text-decoration: none;
      white-space: nowrap;
      transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
    }
    .all-tags a:hover { color: var(--accent-deep); border-color: var(--accent-deep); }
    .all-tags a.here { color: var(--accent-deep); border-color: var(--accent-deep); }

    @media (max-width: 720px) {
      .shelf-list a { grid-template-columns: 1fr auto; }
      .shelf-list .no { display: none; }
      .shelf-list p { grid-column: 1 / -1; padding-left: 0; }
    }
  </style>
</Base>
