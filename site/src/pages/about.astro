---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { TRACKS } from '../data/tracks';

// The Academy plate reads its own catalogue, so its figures cannot go stale.
const guides = (await getCollection('guides')).filter((g) => g.data.status === 'published');
const guideCount = guides.length;
const guideMinutes = guides.reduce((sum, g) => sum + g.data.minutes, 0);
const trackCounts = TRACKS.map((t) => ({
  name: t.constellation,
  count: guides.filter((g) => g.data.track === t.slug).length,
}));

// The questions render below as designed plates; the same strings feed the
// FAQPage JSON-LD through Base, so the page and its markup agree.
const faq = [
  {
    q: 'Who am I?',
    a: 'I’m Ryan D. Allen, a full stack developer. I design and build websites, brands, and useful software, and I ship end to end. Fable, Opus, and Sol are the workforce and audit team. I edit CoreWise Academy.',
  },
  {
    q: 'How I build',
    a: 'AI helps me build faster. Clear direction and independent verification help me build better. Every change runs one loop: clear plan, agent build, real-world tests, independent review, refine and correct. I tune model choice and thinking budgets for the highest quality and accuracy at the lowest cost.',
  },
  {
    q: 'How I think about design',
    a: 'Simplicity first: no one should be confused or have to guess, and complexity does not need to be complicated. Context and specificity: vague goals produce bad results, so define audience, purpose, and brand. Preferences change with audience and situation. Never stop after one pass from one model.',
  },
];

// Schedule of works, second and third rows: the eight details on sheet A-600.
const more = [
  { no: 'A-601', id: 'latter', name: 'LATTER DESIGN', big: '3', k: 'EXPORT FORMATS: PNG, VIDEO, HTML · LAYERED SHADER BACKGROUNDS', url: 'latter.design' },
  { no: 'A-602', id: 'academy', name: 'COREWISE ACADEMY', big: String(guideCount), count: guideCount, k: `GUIDES IN 5 TRACKS · ABOUT ${guideMinutes} MINUTES OF READING`, url: 'corewise.academy' },
  { no: 'A-603', id: 'maimcoil', name: 'MAIMCOIL', big: '110K+', k: 'LINES OF TYPESCRIPT AND RUST · PIXEL-ART ACTION GAME BUILT FOR STEAM', url: 'steam app 4975550' },
  { no: 'A-604', id: 'savetokens', name: 'SAVETOKENS.TIPS', big: '45.3%', k: 'OF OUTPUT TOKENS REMOVED, MEASURED · 681.7M TOKENS SAVED', url: 'savetokens.tips' },
  { no: 'A-605', id: 'harness', name: 'HARNESS FIRMWARE', big: '54', count: 54, k: 'SKILLS FOR CLAUDE CODE, 50 FOR CODEX · PROJECT MEMORY', url: 'harnessfirmware.com' },
  { no: 'A-606', id: 'securewall', name: 'SECURE WALL', big: '0', k: 'CONNECTIONS WITHOUT A RULE · DEFAULT-DENY WINDOWS FIREWALL', url: 'secwall.org' },
  { no: 'A-607', id: 'stk', name: 'STK', big: '16 KB', k: 'READ THRESHOLD · LARGER FILES RETURN AN OUTLINE OF 80 LINES AT MOST', url: 'savetokens.tips/stk' },
  { no: 'A-608', id: 'mavvi', name: 'MAVVI', big: '6', count: 6, k: 'SPARKLING FERMENTED COCKTAILS · PROTOTYPE BRAND SITE', url: 'prototype' },
];

// Sheet A-600: one drawn detail per featured work. `fig` is the host id the
// client engine (about-details.js, about-plates.js) draws into.
const details = [
  {
    id: 'latter', no: 'A-601', name: 'Latter Design', href: 'https://latter.design/', fig: 'fig-d-latter',
    aria: 'Separate animated layers stacking into one composite background',
    line: 'Give your ideas movement: design in motion',
    note: 'A browser editor for layered, animated shader backgrounds, with a saved-design library and PNG, video and HTML export.',
    stack: 'React · Next.js · Tailwind CSS · WebGL 2 · GLSL',
    facts: [['STATUS', 'LIVE'], ['EXPORTS', 'PNG · VIDEO · HTML']],
  },
  {
    id: 'academy', no: 'A-602', name: 'CoreWise Academy', href: '/', fig: 'fig-d-academy',
    aria: `${guideCount} guides charted as stars in five constellations, one per track`,
    line: 'A free library for learning to work with AI',
    note: 'Original guides on working with AI. An agent drafts each one from its sources, and I read it before it merges.',
    stack: 'Astro · MDX · TypeScript · Three.js',
    facts: [['GUIDES', String(guideCount)], ['READING', `${guideMinutes} MIN`], ['TRACKS', '5'], ['SELF-CHECK', '3 QUESTIONS PER GUIDE']],
    data: JSON.stringify(trackCounts),
  },
  {
    id: 'maimcoil', no: 'A-603', name: 'MAIMCOIL', href: 'https://store.steampowered.com/app/4975550/MAIMCOIL/', fig: 'fig-pixelswarm',
    aria: 'Maimcoil drawn entirely in phantom line',
    line: 'A pixel-art action game built for Steam',
    note: 'A survivors-style action game: Tauri 2 and React with a Rust/Steamworks bridge. A playable prototype is live at <a href="https://corewise.video/play">corewise.video/play ↗</a>.',
    stack: 'TypeScript · React · Tauri · Steamworks',
    facts: [['STEAM APP', '4975550'], ['GAME CODE', '110K+ LINES · TYPESCRIPT AND RUST'], ['LINE', 'PHANTOM · UNRELEASED']],
  },
  {
    id: 'savetokens', no: 'A-604', name: 'savetokens.tips', href: 'https://savetokens.tips/', fig: 'fig-d-savetokens',
    aria: 'Command output before and after filtering, with 45.3 percent of the tokens removed',
    line: 'A measured guide to using fewer AI tokens',
    note: 'Token-saving habits for Claude Code and Codex, published as a component datasheet. Each figure is marked as measured or as an estimate.',
    stack: 'HTML · Node.js · PowerShell',
    facts: [['MEASURED', '45.3% OF OUTPUT TOKENS REMOVED'], ['SAVED', '681.7M TOKENS · 529,601 COMMANDS'], ['HABITS', '12'], ['SNAPSHOT', '10 NOV 2026 · REFRESHED DAILY']],
  },
  {
    id: 'harness', no: 'A-605', name: 'Harness Firmware', href: 'https://harnessfirmware.com', fig: 'fig-d-harness',
    aria: 'The harness loop: recall, work, verify, refine, reviewed change, next task',
    line: 'Project memory and workflows for AI coding',
    note: 'A repository starter for Claude Code and Codex: versioned instructions, durable project memory, reusable skills, and workflows for testing and independent review. Full sheet: <a href="#sec-a650">A-650</a>.',
    stack: 'PowerShell · JavaScript',
    facts: [['SKILLS', '54 CLAUDE CODE · 50 CODEX'], ['SPLIT', '8 CORE · 19 DISCIPLINE · 27 SPECIALIST'], ['LICENSE', 'MIT']],
  },
  {
    id: 'securewall', no: 'A-606', name: 'Secure Wall', href: 'https://www.secwall.org/', fig: 'fig-d-securewall',
    aria: 'Apps on one side of a wall and the network on the other: only connections with a rule pass',
    line: 'Choose which apps connect with a Windows firewall',
    note: 'A default-deny firewall for Windows 10 and 11, built on TinyWall. Nothing reaches the network until a rule allows it, and an unknown app gets a prompt.',
    stack: 'C# · .NET · Windows Filtering Platform',
    facts: [['POLICY', 'DEFAULT DENY'], ['PROMPT', 'ALLOW OUTGOING · ALWAYS ALLOW · IGNORE'], ['BUILDS', 'X64 · ARM64 · X86'], ['STATUS', 'ALPHA · GPL-3.0']],
  },
  {
    id: 'stk', no: 'A-607', name: 'STK', href: 'https://savetokens.tips/stk', fig: 'fig-d-stk',
    aria: 'A long file stopped at a 16,384 byte threshold and returned as a short line-numbered outline',
    line: 'Keep large file reads out of an agent’s context',
    note: 'One Rust binary for Claude Code and Codex. A whole-file read over the threshold comes back as a line-numbered outline, so the agent fetches only the part it needs.',
    stack: 'Rust · Claude Code hooks',
    facts: [['THRESHOLD', '16,384 BYTES · 51,200 FOR MARKDOWN'], ['OUTLINE', '80 LINES AT MOST'], ['TESTS', '41 UNIT'], ['LICENSE', 'MIT']],
  },
  {
    id: 'mavvi', no: 'A-608', name: 'MAVVI', href: '', fig: 'fig-d-mavvi',
    aria: 'A flavor wheel with six sectors, one per drink',
    line: 'A website for six sparkling fermented cocktails',
    note: 'A prototype brand site for six flavors: Apple Crush, Berry Drift, Guava Hour, Matcha Mood, Pineapple Day, and Vanilla Dusk.',
    stack: 'HTML · CSS · JavaScript · Three.js · Canvas 2D',
    facts: [['FLAVORS', '6'], ['STATUS', 'PROTOTYPE']],
  },
];

// Sheet A-800: the six steps the film walks through. `at` is the film time in
// seconds each step starts (kept in step with CHAPTERS in about-film.js).
const steps = [
  { at: 20, name: 'Find the slowest step together', sub: 'Find where customers drop off' },
  { at: 29, name: 'Break the goal down', sub: 'Turn the goal into testable steps' },
  { at: 38, name: 'Build the fix', sub: 'Build fast, review every change' },
  { at: 48, name: 'Test it many times', sub: 'Repeat, score and compare' },
  { at: 57, name: 'Hand it over', sub: 'You own the code and the tools' },
  { at: 66, name: 'Continue to optimize', sub: 'Find the next weak point' },
];
const terms = [
  ['We agree the scope first', 'Before I build anything, we agree what it is and how we’ll test it.'],
  ['Every change gets checked', 'AI is fast and sometimes confidently wrong, so each change gets an independent review and a real-world test before you see it.'],
  ['It’s all yours', 'The code, the tools, and the flow behind them are yours.'],
  ['You won’t need me to run it', 'Workflows can run on their own schedule, so I never become your next bottleneck.'],
];
---

<Base
  title="Ryan D. Allen, Full Stack Developer · CoreWise Academy"
  description="Ryan D. Allen builds and ships AI systems end to end. Twelve featured works, presented as a technical drawing set, and the method behind them."
  dateModified="2026-11-10"
  faq={faq}
  crumbs={[{ name: 'About the editor', path: '/about/' }]}
>
  <main id="aw">
    <!-- A-000 · cover -->
    <section class="sheet hero" data-sheet="A-000">
      <div class="hero-grid">
        <div class="hero-mast">
          <p class="aw-kicker">APPROVED WORKS · SET A</p>
          <h1 class="hero-name">Ryan D. Allen</h1>
          <div class="hero-rule"></div>
          <p class="hero-role">FULL STACK DEVELOPER</p>
          <p class="hero-line">I design and build websites, brands, and useful software</p>
          <p class="hero-cta">
            <a class="btn solid" href="#contact">Get in touch</a>
            <a class="btn" href="https://fullbuild.ai">fullbuild.ai ↗</a>
          </p>
          <ul class="hero-links" aria-label="Live work">
            <li><a href="https://corewise.video">corewise.video</a></li>
            <li><a href="https://kinefractal.com">kinefractal.com</a></li>
            <li><a href="https://truenote.org">truenote.org</a></li>
            <li><a href="https://willaicite.com">willaicite.com</a></li>
            <li><a href="https://latter.design/">latter.design</a></li>
            <li><a href="https://savetokens.tips">savetokens.tips</a></li>
            <li><a href="https://harnessfirmware.com">harnessfirmware.com</a></li>
            <li><a href="https://github.com/ryanportfolio">github.com/ryanportfolio</a></li>
          </ul>
        </div>
        <div class="hero-fig" id="fig-hero" aria-label="Six model strands converging to one synthesis, drawn in true perspective"></div>
      </div>
    </section>

    <!-- A-001 · index + line law -->
    <section class="sheet" data-sheet="A-001" id="sec-a001">
      <ol class="idx">
        <li><a href="#sec-a002"><span class="idx-no">A-002</span><span class="idx-name">General notes</span><span class="idx-tag">NOTES</span></a></li>
        <li><a href="#sec-a100"><span class="idx-no">A-100</span><span class="idx-name">CoreWise · six-model synthesis</span><span class="idx-live"><span class="ext">corewise.video ↗</span> LIVE</span></a></li>
        <li><a href="#sec-a200"><span class="idx-no">A-200</span><span class="idx-name">KineFractal · rule-based signal engine</span><span class="idx-live"><span class="ext">kinefractal.com ↗</span> LIVE</span></a></li>
        <li><a href="#sec-a300"><span class="idx-no">A-300</span><span class="idx-name">Truenote · cited answers or refusal</span><span class="idx-live"><span class="ext">truenote.org ↗</span> LIVE</span></a></li>
        <li><a href="#sec-a400"><span class="idx-no">A-400</span><span class="idx-name">WillAICite · deterministic GEO audit</span><span class="idx-live"><span class="ext">willaicite.com ↗</span> LIVE</span></a></li>
        <li><a href="#sec-a500"><span class="idx-no">A-500</span><span class="idx-name">Method of construction</span><span class="idx-tag">METHOD</span></a></li>
        <li><a href="#sec-a600"><span class="idx-no">A-600</span><span class="idx-name">Featured works · eight details</span><span class="idx-tag">DETAILS</span></a></li>
        <li><a href="#sec-a650"><span class="idx-no">A-650</span><span class="idx-name">Harness Firmware · how I engineer with AI</span><span class="idx-tag">TEMPLATE</span></a></li>
        <li><a href="#sec-a700"><span class="idx-no">A-700</span><span class="idx-name">Workshop · tooling and prototypes</span><span class="idx-tag">WORKSHOP</span></a></li>
        <li><a href="#sec-a800"><span class="idx-no">A-800</span><span class="idx-name">Solving bottlenecks · how I work with you</span><span class="idx-tag">FILM</span></a></li>
        <li><a href="#contact"><span class="idx-no">A-1000</span><span class="idx-name">Questions and contact</span><span class="idx-tag">CONTACT</span></a></li>
        <li><a href="#sec-a1100"><span class="idx-no">A-1100</span><span class="idx-name">Closing note</span><span class="idx-tag">LAST SHEET</span></a></li>
      </ol>

      <div class="hold" aria-label="Schedule of works: one key figure per featured work">
        <p class="hold-head"><span>SCHEDULE OF WORKS</span><span>12 FEATURED</span></p>
        <div class="hold-grid">
          <a class="hold-cell ink-vermilion" href="#sec-a100">
            <span class="hold-top"><span class="hold-no">A-100</span><span class="hold-name">COREWISE</span></span>
            <span class="hold-big"><span data-count="650">650</span>M+</span>
            <span class="hold-k">TOKENS PROCESSED FOR 1,880+ REGISTERED USERS · 6 AI MODELS IN PARALLEL</span>
            <span class="hold-url">corewise.video&nbsp;↗</span>
          </a>
          <a class="hold-cell ink-prussian" href="#sec-a200">
            <span class="hold-top"><span class="hold-no">A-200</span><span class="hold-name">KINEFRACTAL</span></span>
            <span class="hold-big" data-count="1227">1,227</span>
            <span class="hold-k">COMMITS IN THE FIRST MONTH · 519 MERGED PRS · PAPER ACCOUNT</span>
            <span class="hold-url">kinefractal.com&nbsp;↗</span>
          </a>
          <a class="hold-cell ink-viridian" href="#sec-a300">
            <span class="hold-top"><span class="hold-no">A-300</span><span class="hold-name">TRUENOTE</span></span>
            <span class="hold-big funnel">40+40→8→1</span>
            <span class="hold-k">UP TO 80 SOURCES NARROWED TO ONE CITED ANSWER, OR A REFUSAL</span>
            <span class="hold-url">truenote.org&nbsp;↗</span>
          </a>
          <a class="hold-cell ink-ochre" href="#sec-a400">
            <span class="hold-top"><span class="hold-no">A-400</span><span class="hold-name">WILLAICITE</span></span>
            <span class="hold-big"><span data-count="161">161</span>+</span>
            <span class="hold-k">AUTOMATED TESTS · ANSWER ENGINE OPTIMIZATION AUDIT · ZERO AI CALLS</span>
            <span class="hold-url">willaicite.com&nbsp;↗</span>
          </a>
          {
            more.map((m) => (
              <a class="hold-cell" href={`#det-${m.id}`}>
                <span class="hold-top"><span class="hold-no">{m.no}</span><span class="hold-name">{m.name}</span></span>
                <span class="hold-big">{m.count ? <span data-count={m.count}>{m.big}</span> : m.big}</span>
                <span class="hold-k">{m.k}</span>
                <span class="hold-url">{m.url}</span>
              </a>
            ))
          }
        </div>
      </div>

      <p class="credo">
        <span>idea</span>
        <svg class="credo-star" viewBox="0 0 52 16" aria-hidden="true">
          <path class="cs-line" d="M2 8 H43" />
          <path class="cs-head" d="M38 3.5 L45 8 L38 12.5" />
          <path class="cs-comet" d="M2 8 H43" />
        </svg>
        <span>design</span>
        <svg class="credo-star" viewBox="0 0 52 16" aria-hidden="true">
          <path class="cs-line" d="M2 8 H43" />
          <path class="cs-head" d="M38 3.5 L45 8 L38 12.5" />
          <path class="cs-comet" d="M2 8 H43" />
        </svg>
        <span>engineering</span>
        <svg class="credo-star" viewBox="0 0 52 16" aria-hidden="true">
          <path class="cs-line" d="M2 8 H43" />
          <path class="cs-head" d="M38 3.5 L45 8 L38 12.5" />
          <path class="cs-comet" d="M2 8 H43" />
        </svg>
        <span>audit</span>
        <svg class="credo-loop" viewBox="0 0 24 24" aria-hidden="true">
          <g class="cl-spin">
            <path class="cl-arc" d="M12 4 A8 8 0 1 1 5.07 8" />
            <path class="cl-head" d="M0 -3.2 L5 0 L0 3.2" transform="translate(5.07 8) rotate(-60)" />
          </g>
        </svg>
        <span class="credo-shipped">shipped</span>
      </p>
    </section>

    <!-- A-002 · general notes -->
    <section class="sheet" data-sheet="A-002" id="sec-a002">
      <header class="sheet-head">
        <div>
          <p class="sheet-no">A-002</p>
          <h2 class="sheet-title">GENERAL NOTES</h2>
        </div>
        <p class="sheet-sub">APPLY TO EVERY SHEET</p>
      </header>

      <figure class="note note-wide">
        <p class="note-no">NOTE 1</p>
        <p class="note-big">More agents &amp; tokens <span class="note-neq">&#8800;</span> better results</p>
        <div class="note-tb">
          <span class="note-cell"><span class="note-k">WRITTEN BY</span>R. ALLEN</span>
          <span class="note-cell wide"><span class="note-k">LEARNED ON</span>SET A: 1,227 COMMITS IN MONTH ONE, 519 MERGED PRS, ONE HUMAN GATE</span>
          <span class="note-cell"><span class="note-k">STATUS</span>HOUSE RULE</span>
        </div>
      </figure>

      <p class="body-block note-after">Fast generation without value &#8594; longer review &#8594;<br />added
        burden rather than saved time</p>
      <p class="note-refer">
        <span class="note-k">REFER TO</span>
        <a href="/guides/thinking-on-a-budget/">Thinking on a budget</a> ·
        <a href="/guides/brief-the-model/">Brief the model like a brilliant new hire</a> ·
        <a href="/guides/stop-hitting-your-token-limit/">Stop hitting your token limit</a>
      </p>
      <p class="note-cta">
        <a class="btn btn-xl" href="/guides/">
          <svg class="cta-star" viewBox="0 0 24 24" aria-hidden="true">
            <path class="cs-core" d="M12 1.5 L14.4 9.6 L22.5 12 L14.4 14.4 L12 22.5 L9.6 14.4 L1.5 12 L9.6 9.6 Z" />
            <path class="cs-spark" d="M17.6 6.4 L14.1 12 L17.6 17.6 L12 14.1 L6.4 17.6 L9.9 12 L6.4 6.4 L12 9.9 Z" />
          </svg>
          <span>Read the guides</span>
        </a>
      </p>

      <figure class="note">
        <p class="note-no">NOTE 2</p>
        <p class="note-lead">I MEASURE SUCCESS BY</p>
        <div class="note-formula" role="math" aria-label="Solutions Identified times Solutions Delivered, divided by Time">
          <span class="nf-num">(Solutions Identified <span class="nf-op">&#215;</span> Solutions Delivered)</span>
          <span class="nf-rule" aria-hidden="true"></span>
          <span class="nf-den">Time</span>
        </div>
      </figure>

    </section>

    <!-- A-100 · CoreWise -->
    <section class="sheet" data-sheet="A-100" id="sec-a100">
      <header class="sheet-head ink-vermilion">
        <div>
          <p class="sheet-no">A-100</p>
          <h2 class="sheet-title">COREWISE · SYNTHESIS CHANDELIER</h2>
        </div>
        <p class="sheet-sub">MULTI-MODEL SYNTHESIS · LIVE</p>
      </header>
      <div class="cols">
        <div class="main">
          <p class="lede">One URL goes in. Six models read it in parallel. Out comes a synthesis: where
            they agree, where they split, and what only one of them saw.</p>
          <div class="fig ink-vermilion" id="fig-chandelier" aria-label="The synthesis chandelier, six strands converging to one apex"></div>
          <p class="fig-cap"><span class="fig-no">FIG 1</span>Six model strands descend from one source, cross the
            ring, and converge to one synthesis.</p>
          <div class="fig-row">
            <div class="fig ink-vermilion" id="fig-disc" aria-label="109 engraved spokes, one per hundred commits"></div>
            <p class="fig-cap narrow"><span class="fig-no">FIG 2</span>109 engraved spokes, one per 100 commits:
              ~10.9k GitHub-attributed commits across ~8 months.</p>
          </div>
        </div>
        <aside class="rail ink-vermilion">
          <p class="rail-head">COREWISE</p>
          <a class="rail-url" href="https://corewise.video">corewise.video ↗</a>
          <div class="rail-rule"></div>
          <dl>
            <dt>STATUS</dt><dd>LIVE · VERIFIED REACHABLE</dd>
            <dt>MODELS IN PARALLEL</dt><dd>6</dd>
            <dt>REGISTERED USERS</dt><dd>1,880+</dd>
            <dt>COMMITS</dt><dd>~10.9K / ~8 MO</dd>
            <dt>PLATFORMS</dt><dd>WEB · MOBILE (PWA) · FIREFOX + CHROME EXTENSION · MCP SERVER</dd>
            <dt>BILLING / EXPORT</dt><dd>STRIPE · NOTION / PDF / TTS</dd>
          </dl>
          <p class="rail-note">“Six models cross-examine one source.”</p>
        </aside>
      </div>
    </section>

    <!-- A-200 · KineFractal -->
    <section class="sheet" data-sheet="A-200" id="sec-a200">
      <header class="sheet-head ink-prussian">
        <div>
          <p class="sheet-no">A-200</p>
          <h2 class="sheet-title">KINEFRACTAL · TEN-GATE CORRIDOR</h2>
        </div>
        <p class="sheet-sub">RULE-BASED SIGNAL ENGINE · LIVE · PAPER</p>
      </header>
      <div class="cols">
        <div class="main">
          <p class="lede">It buys into the broad market when fear runs high, and protects profits gradually as prices rise. One engine produces every
            backtest and the daily public signal. Ten machine gates stand between signal and order, and two
            human steps follow: a person arms the run, then types transmit.</p>
          <div class="fig ink-prussian" id="fig-corridor" aria-label="Ten pre-trade gates in one-point perspective"></div>
          <div class="gate-panel">
            <p class="gate-readout" id="gate-readout">GATES CLOSED 00 / 10</p>
            <p class="gate-note">This is the real protocol, miniaturized: no order transmits until a human
              arms the run, then types transmit by hand. Paper account.</p>
          </div>
          <div class="gatekey">
            <p><b>01</b> DECISION FROM PREVIOUS CLOSED NYSE SESSION</p>
            <p><b>03</b> LEDGER AND BROKER QUANTITIES MUST AGREE</p>
            <p><b>05</b> BUYS CANNOT EXCEED AVAILABLE FUNDS</p>
            <p><b>07</b> STALE GATEWAY FAILS CLOSED</p>
            <p class="human"><b>+1</b> A HUMAN ARMS THE RUN</p>
            <p class="human"><b>+2</b> A HUMAN TYPES TRANSMIT</p>
          </div>
          <p class="fig-cap"><span class="fig-no">FIG 1</span>Ten pre-trade gates in one-point perspective; all ten
