    .gate-panel { margin: var(--s-2) 0; display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }
    .gate-readout { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--aw-prus); flex-basis: 100%; }
    .gate-note { font-family: var(--font-body); font-style: italic; font-size: var(--text-sm); color: var(--aw-sepia); flex-basis: 100%; max-width: 52ch; }
    .gatekey { display: grid; grid-template-columns: 1fr 1fr; gap: 4px var(--s-4); margin: var(--s-2) 0; max-width: 640px; }
    .gatekey p { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em; color: var(--awg); }
    .gatekey b { color: var(--aw-prus); font-weight: 500; padding-right: 6px; }
