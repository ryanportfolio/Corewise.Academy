    .fig-cap.narrow { max-width: 32ch; }
    .fig-no { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--awc); padding-right: 10px; }
    .sec-head { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xs); letter-spacing: 0.2em; margin: var(--s-4) 0 var(--s-2); }
    .mono-link { font-family: var(--font-mono); font-size: var(--text-2xs); margin-top: var(--s-1); }
    .mono-link a, .works a, .rail-url { color: var(--ink-soft); }

    /* ---- index ---- */
    .idx { list-style: none; padding: 0; margin: 0 0 var(--s-2); }
    .idx li { border-bottom: 1px solid var(--line-soft); }
