    .cl-arc { stroke: var(--awc); stroke-width: 1.8; fill: none; stroke-linecap: round; }
    .cl-head { stroke: var(--awc); stroke-width: 1.8; fill: none; stroke-linejoin: round; stroke-linecap: round; }
