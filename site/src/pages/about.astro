    .hold-cell:hover, .hold-cell:focus-visible { background: color-mix(in srgb, var(--sheet-ink) 7%, transparent); }
    .hold-cell:hover::before, .hold-cell:focus-visible::before { height: 6px; }
    .hold-top { display: flex; flex-direction: column; gap: 3px; font-family: var(--font-mono); font-weight: 500; }
    .hold-no { font-size: var(--text-2xs); letter-spacing: 0.1em; color: var(--awg); white-space: nowrap; }
    .hold-name { font-size: var(--text-2xs); letter-spacing: 0.16em; color: var(--sheet-ink); white-space: nowrap; }
