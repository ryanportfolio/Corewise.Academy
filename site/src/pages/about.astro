    .note-why { margin: var(--s-4) 0 var(--s-6); }
    .note-after { margin: var(--s-4) 0 var(--s-2); }
    .note-refer { font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 2; }
    .note-refer .note-k { display: inline; margin-right: 10px; }
    .note-refer a { color: var(--ink-soft); text-decoration-color: var(--line); }
    .note-refer a:hover { color: var(--accent-deep); }
    .note-cta { margin: var(--s-3) 0 var(--s-6); }
    /* the guides CTA: twice the standard button, with the atlas star turning inside it */
    .btn-xl { display: inline-flex; align-items: center; gap: 16px; font-size: var(--text-md); padding: 24px 44px; }
    .cta-star { width: 1.6em; height: 1.6em; flex: none; fill: currentColor; }
    .cs-core { transform-origin: 12px 12px; animation: cta-turn 18s linear infinite; }
