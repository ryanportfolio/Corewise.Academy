    .note-no { font-family: var(--font-mono); font-weight: 500; font-size: 0.5rem; letter-spacing: 0.22em; color: var(--awg); padding: 8px var(--s-4) 0; }
    .note-big { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 6.4vw, 4.6rem); line-height: 1.04; letter-spacing: -0.01em; padding: var(--s-3) var(--s-4) var(--s-4); text-wrap: balance; }
    .note-neq { font-family: var(--font-mono); font-weight: 500; font-size: 0.86em; padding: 0 0.06em; }
    .note-lead { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.18em; color: var(--awg); padding: var(--s-3) var(--s-4) 0; }
    .note-formula { display: grid; justify-content: center; justify-items: stretch; gap: 8px; font-family: var(--font-body); font-size: clamp(1.05rem, 2.7vw, var(--text-xl)); line-height: 1.2; padding: var(--s-3) var(--s-4) var(--s-4); text-align: center; }
    .nf-op { font-family: var(--font-mono); font-size: 0.82em; }
