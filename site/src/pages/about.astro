  <style>
    /* ============================================================
       Approved Works · drawing-set language on Academy paper.
       Scoped tokens: chapter inks tuned for day and night themes.
       ============================================================ */
    /* this page is Ryan's, not the Academy's: the wordmark drops its suffix here */
    :global(.masthead .wordmark em) { display: none; }

    #aw {
      --awc: var(--ink);                 /* carbon key */
      --awg: var(--ink-mute);            /* graphite */
      --awf: var(--line);                /* faint construction */
      --aw-verm: #b23a24;
      --aw-prus: #2c4e71;
      --aw-viri: #33685a;
      --aw-ochr: #a0731f;
      --aw-sepia: #7c5c43;
      position: relative;
      padding-bottom: 64px;
    }
    :global([data-theme='night']) #aw {
      --aw-verm: #e0765c;
      --aw-prus: #85a5cd;
      --aw-viri: #74b39a;
      --aw-ochr: #d2a24e;
      --aw-sepia: #bb9878;
    }

    .sheet {
      max-width: 1060px;
      margin: 0 auto;
      padding: var(--s-8) var(--s-4) var(--s-6);
      border-bottom: 1px solid var(--line);
      position: relative;
    }
    .sheet.last { border-bottom: 0; }

    /* ---- hero ---- */
    .hero { padding-top: var(--s-6); }
    .hero-grid { display: grid; grid-template-columns: minmax(300px, 1fr) minmax(320px, 520px); gap: var(--s-4); align-items: center; }
    .aw-kicker { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-2xs); letter-spacing: 0.24em; color: var(--awg); }
    .hero-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(3rem, 7vw, var(--text-4xl)); line-height: 1.02; margin-top: var(--s-2); }
    .hero-rule { width: 120px; height: 2px; background: var(--awc); margin: var(--s-3) 0; }
    .hero-line { font-family: var(--font-body); font-size: var(--text-md); max-width: 26ch; }
    .hero-links { font-family: var(--font-mono); font-size: var(--text-xs); margin-top: var(--s-2); line-height: 2; }
    .hero-links a { color: var(--ink-soft); text-decoration-color: var(--line); }
    .hero-links a:hover { color: var(--accent-deep); }
    .hero-hint { font-family: var(--font-body); font-style: italic; font-size: var(--text-sm); color: var(--aw-sepia); max-width: 40ch; margin-top: var(--s-3); }
    .hero-fig { min-height: 340px; cursor: crosshair; }

    /* ---- sheet head ---- */
    .sheet-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-2); border-bottom: 1.5px solid var(--awc); padding-bottom: var(--s-2); margin-bottom: var(--s-4); }
    .sheet-no { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xl); letter-spacing: 0.04em; color: var(--sheet-ink, var(--awc)); }
    .sheet-title { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-sm); letter-spacing: 0.18em; margin-top: 4px; }
    .sheet-sub { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.2em; color: var(--awg); text-align: right; max-width: 30ch; }
    .ink-vermilion { --sheet-ink: var(--aw-verm); }
    .ink-prussian { --sheet-ink: var(--aw-prus); }
    .ink-viridian { --sheet-ink: var(--aw-viri); }
    .ink-ochre { --sheet-ink: var(--aw-ochr); }

    /* ---- columns ---- */
    .cols { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: var(--s-6); }
    .lede { font-family: var(--font-body); font-size: var(--text-md); line-height: 1.5; max-width: 46ch; margin-bottom: var(--s-3); }
    .body-block { font-family: var(--font-body); font-size: var(--text-base); max-width: 58ch; margin-bottom: var(--s-3); }
    .body-block.small { font-size: var(--text-sm); }
    .fig { margin: var(--s-2) 0 0; }
    .fig-row { display: flex; gap: var(--s-4); align-items: center; flex-wrap: wrap; }
    .side-copy { max-width: 300px; }
    .fig-cap { font-family: var(--font-body); font-size: var(--text-sm); color: var(--ink-soft); max-width: 60ch; margin: var(--s-1) 0 var(--s-3); }
    .fig-cap.narrow { max-width: 32ch; }
    .fig-no { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--awc); padding-right: 10px; }
    .sec-head { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xs); letter-spacing: 0.2em; margin: var(--s-4) 0 var(--s-2); }
    .mono-link { font-family: var(--font-mono); font-size: var(--text-2xs); margin-top: var(--s-1); }
    .mono-link a, .works a, .rail-url { color: var(--ink-soft); }

    /* ---- index ---- */
    .idx { list-style: none; padding: 0; margin: 0 0 var(--s-2); }
    .idx li { border-bottom: 1px solid var(--line-soft); }
    .idx a { display: grid; grid-template-columns: 90px 1fr auto; gap: var(--s-2); align-items: baseline; padding: 10px 0; text-decoration: none; color: var(--ink); }
    .idx a:hover .idx-name { color: var(--accent-deep); }
    .idx-no { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xs); }
    .idx-name { font-family: var(--font-body); font-size: var(--text-base); transition: color var(--dur) var(--ease); }
    .idx-live, .idx-tag { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.1em; color: var(--awg); }
    .idx-live .ext { border-bottom: 1px solid var(--line); }

    /* ---- legend ---- */
    .legend { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--s-2); }
    .legend-row { display: flex; align-items: center; gap: var(--s-2); background: none; border: 0; padding: 4px 0; cursor: pointer; text-align: left; }
    .legend-row svg { width: 120px; height: 12px; flex: 0 0 auto; }
    .legend-row span { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--ink-soft); }
    .legend-row:hover span, .legend-row:focus-visible span { color: var(--accent-deep); }
    .lg-solid { stroke: var(--awc); stroke-width: 1.6; }
    .lg-dashed { stroke: var(--awc); stroke-width: 1.3; stroke-dasharray: 6, 4; }
    .lg-phantom { stroke: var(--awc); stroke-width: 1.3; stroke-dasharray: 8, 4, 2, 4, 2, 4; }

    /* legend audit: dim everything that is not the hovered convention */
    :global(#aw[data-hl] .plate-svg [data-conv]) { transition: opacity 0.25s ease; opacity: 0.12; }
    :global(#aw[data-hl='solid'] .plate-svg [data-conv='solid']) { opacity: 1; }
    :global(#aw[data-hl='dashed'] .plate-svg [data-conv='dashed']) { opacity: 1; }
    :global(#aw[data-hl='phantom'] .plate-svg [data-conv='phantom']) { opacity: 1; }

    /* ---- holdings ---- */
    .hold { display: grid; grid-template-columns: repeat(4, 1fr); border: 1.5px solid var(--awc); margin-bottom: var(--s-3); }
    .hold-cell { padding: var(--s-2); border-right: 1px solid var(--awc); }
    .hold-cell:last-child { border-right: 0; }
    .hold-big { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-lg); }
    .hold-big.funnel { font-size: var(--text-md); padding-top: 6px; }
    .hold-k { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.08em; color: var(--awg); margin-top: 6px; line-height: 1.5; }

    /* ---- rail ---- */
    .rail { border-left: 1px solid var(--line); padding-left: var(--s-3); align-self: start; position: sticky; top: 92px; }
    .rail-head { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-sm); letter-spacing: 0.14em; color: var(--sheet-ink, var(--awc)); }
    .rail-url { display: inline-block; font-family: var(--font-mono); font-size: var(--text-2xs); margin-top: 4px; }
    .rail-rule { width: 34px; height: 2px; background: var(--sheet-ink, var(--awc)); margin: var(--s-2) 0; }
    .rail dl { margin: 0; }
    .rail dt { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; color: var(--awg); margin-top: var(--s-2); }
    .rail dd { font-family: var(--font-mono); font-size: var(--text-2xs); margin: 2px 0 0; line-height: 1.6; }
    .rail-boxed { border: 1.5px solid var(--awc); padding: 8px 10px; font-family: var(--font-mono); font-weight: 500; font-size: 0.62rem; letter-spacing: 0.1em; margin-top: var(--s-2); line-height: 1.7; }
    .rail-note { font-family: var(--font-body); font-style: italic; font-size: var(--text-sm); color: var(--aw-sepia); margin-top: var(--s-3); line-height: 1.6; }

    /* ---- controls ---- */
    .aw-btn {
      font-family: var(--font-mono); font-weight: 500; font-size: var(--text-2xs); letter-spacing: 0.14em;
      background: none; border: 1.5px solid var(--awc); color: var(--ink); padding: 10px 16px; cursor: pointer;
      transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
    }
    .aw-btn:hover:not(:disabled) { background: var(--awc); color: var(--paper); }
    .aw-btn:disabled { opacity: 0.6; cursor: default; }
    .gate-panel { margin: var(--s-2) 0; display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }
    .gate-readout { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--aw-prus); flex-basis: 100%; }
    .confirm-wrap { display: none; gap: var(--s-1); }
    .confirm-wrap.ready { display: inline-flex; }
    #input-confirm {
      font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.14em; text-transform: uppercase;
      background: none; border: 1.5px solid var(--line); border-bottom-color: var(--awc); color: var(--ink);
      padding: 10px 12px; width: 18ch;
    }
    #input-confirm:focus { outline: none; border-color: var(--aw-verm); }
    :global(.shake) { animation: aw-shake 0.35s; }
    @keyframes aw-shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
    .gate-note { font-family: var(--font-body); font-style: italic; font-size: var(--text-sm); color: var(--aw-sepia); flex-basis: 100%; max-width: 52ch; }
    .gatekey { display: grid; grid-template-columns: 1fr 1fr; gap: 4px var(--s-4); margin: var(--s-2) 0; max-width: 640px; }
    .gatekey p { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em; color: var(--awg); }
    .gatekey b { color: var(--aw-prus); font-weight: 500; padding-right: 6px; }
    .gatekey .human, .gatekey .human b { color: var(--aw-verm); }
    .conf-panel { margin: var(--s-2) 0; max-width: 420px; }
    .conf-label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; color: var(--awg); }
    #conf-slider { width: 100%; accent-color: var(--aw-viri); margin: 8px 0 4px; }
    .conf-readout { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.1em; color: var(--aw-viri); }
    :global(#sec-a300.refusing .conf-readout) { color: var(--aw-verm); }
    .seal-panel { display: flex; gap: var(--s-2); align-items: center; flex-wrap: wrap; margin: var(--s-2) 0; }
    .seal-meter { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; color: var(--awg); }
    .go-panel { margin: var(--s-1) 0; }

    /* ---- figures: stroke classes (global: SVG is built at runtime) ---- */
    :global(#aw .plate-svg) { width: 100%; height: auto; overflow: visible; }
    :global(#aw .plate-svg text) { user-select: none; }
    :global(#aw .st-key) { stroke: var(--sheet-ink, var(--awc)); fill: none; }
    :global(#aw .st-key-thin) { stroke: var(--sheet-ink, var(--awc)); stroke-width: 0.55; fill: none; }
    :global(#aw .st-key-heavy) { stroke: var(--sheet-ink, var(--awc)); stroke-width: 1.35; fill: none; }
    :global(#aw .st-carbon) { stroke: var(--awc); stroke-width: 1; fill: none; }
    :global(#aw .st-carbon-thin) { stroke: var(--awc); stroke-width: 0.55; fill: none; }
    :global(#aw .st-graphite) { stroke: var(--awg); stroke-width: 0.55; fill: none; }
    :global(#aw .st-faint) { stroke: var(--awf); stroke-width: 0.6; fill: none; }
    :global(#aw .st-center) { stroke: var(--awc); stroke-width: 0.5; stroke-dasharray: 16, 4, 2.5, 4; }
    :global(#aw .st-human) { stroke: var(--aw-verm); fill: none; }
    :global(#aw .nd) { fill: var(--paper); stroke: var(--sheet-ink, var(--awc)); stroke-width: 0.9; }
    :global(#aw .nd-solid) { fill: var(--sheet-ink, var(--awc)); }
    :global(#aw .nd-solid.key) { fill: var(--sheet-ink, var(--awc)); }
    :global(#aw .nd-graphite) { fill: var(--awg); }
    :global(#aw .ann) { font-family: var(--font-mono); font-weight: 500; font-size: 10.5px; letter-spacing: 0.07em; fill: var(--awc); }
    :global(#aw .annf) { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.05em; fill: var(--awg); }
    :global(#aw .ann-key) { fill: var(--sheet-ink, var(--awc)); }
    :global(#aw .ann-human) { fill: var(--aw-verm); }
    :global(#aw .dim) { opacity: 0.55; }
    :global(#aw .med) { stroke-width: 1; }
    :global(#aw .flow) { }

    /* confluence: the gate decides which branch is alive */
    :global(#sec-a300 .answer) { transition: opacity 0.35s ease; }
    :global(#sec-a300 .refuse-box), :global(#sec-a300 .refuse-txt), :global(#sec-a300 .refuse-path) { transition: all 0.35s ease; }
    :global(#sec-a300.refusing .answer) { opacity: 0.12; }
    :global(#sec-a300.refusing .refuse-box) { stroke: var(--aw-verm); stroke-width: 1.8; }
    :global(#sec-a300.refusing .refuse-txt) { fill: var(--aw-verm); }
    :global(#sec-a300.refusing .refuse-path) { stroke: var(--aw-verm); }
    :global(#aw .post-live) { stroke: var(--aw-viri); stroke-width: 1.8; }

    /* ---- revisions table ---- */
    .rev { border-collapse: collapse; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em; }
    .rev th { font-size: 0.58rem; letter-spacing: 0.16em; color: var(--awg); text-align: left; padding: 6px 18px 6px 0; border-bottom: 1px solid var(--awc); }
    .rev td { padding: 8px 18px 8px 0; border-bottom: 1px solid var(--line-soft); }
    .works { font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 2.1; }

    /* ---- pinned title block ---- */
    .tb {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      display: flex; align-items: stretch;
      border-top: 1.5px solid var(--awc);
      /* no backdrop-filter here: a fixed blur over this much vector forces a
         full repaint per frame and drops the page to 2 fps */
      background: color-mix(in srgb, var(--paper) 97%, var(--ink) 3%);
      font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em;
    }
    .tb-cell { display: flex; flex-direction: column; gap: 1px; padding: 6px 12px; border-right: 1px solid var(--line); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
    .tb-cell.wide { flex: 1; }
    .tb-k { font-size: 0.5rem; letter-spacing: 0.18em; color: var(--awg); }
    .tb-approved { color: var(--aw-verm); }
    #tb-sheet { color: var(--accent-deep); }
    .tb-zonecell { min-width: 96px; }

    /* ---- responsive ---- */
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
      .cols { grid-template-columns: 1fr; }
      .rail { position: static; border-left: 0; border-top: 1px solid var(--line); padding: var(--s-3) 0 0; }
      .hold { grid-template-columns: repeat(2, 1fr); }
      .hold-cell:nth-child(2) { border-right: 0; }
      .tb-cell.wide, .tb-zonecell { display: none; }
    }
    @media (max-width: 560px) {
      .idx a { grid-template-columns: 64px 1fr; }
      .idx-live, .idx-tag { display: none; }
      .gatekey { grid-template-columns: 1fr; }
    }
  </style>
</Base>
