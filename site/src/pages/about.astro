    .idx a:hover .idx-name { color: var(--accent-deep); }
    .idx-no { font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xs); }
    .idx-name { font-family: var(--font-body); font-size: var(--text-md); transition: color var(--dur) var(--ease); }
    .idx-live, .idx-tag { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.1em; color: var(--awg); }
    .idx-live .ext { border-bottom: 1px solid var(--line); }

    /* ---- legend ---- */
    .legend { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--s-2); }
    .legend-row { display: flex; align-items: center; gap: var(--s-2); background: none; border: 0; padding: 4px 0; cursor: pointer; text-align: left; }
    .legend-row svg { width: 120px; height: 12px; flex: 0 0 auto; }
    .legend-row span { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.12em; color: var(--ink-soft); }
    .legend-row:hover span, .legend-row:focus-visible span { color: var(--accent-deep); }
    .lg-solid { stroke: var(--awc); stroke-width: 1.6; }
    .lg-dashed { stroke: var(--awc); stroke-width: 1.3; stroke-dasharray: 6, 4; }
    .lg-phantom { stroke: var(--awc); stroke-width: 1.3; stroke-dasharray: 8, 4, 2, 4, 2, 4; }

    /* legend audit: dim everything that is not the hovered convention */
    :global(#aw[data-hl] .plate-svg [data-conv]) { transition: opacity 0.25s ease; opacity: 0.12; }
    :global(#aw[data-hl='solid'] .plate-svg [data-conv='solid']) { opacity: 1; }
    :global(#aw[data-hl='dashed'] .plate-svg [data-conv='dashed']) { opacity: 1; }
    :global(#aw[data-hl='phantom'] .plate-svg [data-conv='phantom']) { opacity: 1; }

    /* ---- holdings: schedule of works ---- */
    .hold { border: 1.5px solid var(--awc); margin-bottom: var(--s-3); overflow: hidden; }
    .hold-head {
      display: flex; justify-content: space-between; gap: var(--s-2);
      padding: 7px 12px; border-bottom: 1.5px solid var(--awc);
      font-family: var(--font-mono); font-weight: 500; font-size: 0.58rem; letter-spacing: 0.2em;
    }
    /* twelve cells, four to a row; the -1px margins tuck the outer cell rules under the frame */
    .hold-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0 -1px -1px 0; }
    .hold-cell:not([class*='ink-']) { --sheet-ink: var(--awc); }
    .hold-cell {
      position: relative; display: flex; flex-direction: column; gap: 7px;
      padding: calc(var(--s-2) + 3px) var(--s-2) var(--s-2);
