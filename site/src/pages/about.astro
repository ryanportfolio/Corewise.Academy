    .det:nth-last-child(-n + 2) { border-bottom: 0; }
    .det-head { display: flex; justify-content: space-between; font-family: var(--font-mono); font-weight: 500; font-size: 0.58rem; letter-spacing: 0.2em; color: var(--awg); }
    .det-fig { min-height: 220px; display: flex; align-items: center; justify-content: center; margin: var(--s-2) 0; }
    .det-name { font-family: var(--font-display); font-weight: 400; font-size: var(--text-xl); line-height: 1.05; }
    .det-name a { color: var(--ink); text-decoration: none; transition: color var(--dur) var(--ease); }
    .det-name a span { font-family: var(--font-mono); font-size: 0.5em; color: var(--awg); }
    .det-name a:hover, .det-name a:focus-visible { color: var(--accent-deep); }
    .det-line { font-family: var(--font-body); font-size: var(--text-md); line-height: 1.3; margin-top: 8px; text-wrap: balance; }
    .det-note { font-family: var(--font-body); font-size: var(--text-sm); color: var(--ink-soft); margin: var(--s-1) 0 var(--s-2); max-width: 48ch; }
    .det-facts { margin: auto 0 0; padding-top: var(--s-1); border-top: 1px solid var(--line); display: grid; gap: 3px; }
    .det-facts div { display: grid; grid-template-columns: 104px 1fr; gap: 10px; align-items: baseline; }
    .det-facts dt { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.14em; color: var(--awg); }
    .det-facts dd { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.04em; line-height: 1.6; margin: 0; }

    /* ---- A-700 workshop ---- */
    .shop { display: grid; gap: var(--s-2); margin-bottom: var(--s-3); }
    .shop-item .fig { max-width: 680px; }
    .shop-item .sec-head { margin-top: 0; }
    .shop-more { margin-top: var(--s-3); }

    /* ---- A-800 the film ---- */
    .film-lede { max-width: 52ch; }
    .film { margin: 0; border: 1.5px solid var(--awc); background: color-mix(in srgb, var(--paper) 96%, var(--ink) 4%); }
    .film-stage { position: relative; aspect-ratio: 16 / 9; }
    .film-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; }
    .film-bar {
      display: flex; align-items: center; gap: var(--s-2); padding: 8px 12px;
      border-top: 1px solid var(--awc);
      font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.1em;
    }
    .film-btn {
      font: inherit; font-weight: 500; letter-spacing: 0.14em; min-width: 5.6em;
      background: none; border: 1.5px solid var(--awc); color: var(--ink); padding: 6px 12px; cursor: pointer;
      transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
    }
    .film-btn:hover { background: var(--awc); color: var(--paper); }
    .film-track { position: relative; flex: 1; height: 28px; display: flex; align-items: center; }
    .film-track input { width: 100%; height: 28px; margin: 0; background: transparent; cursor: pointer; appearance: none; -webkit-appearance: none; }
    .film-track input::-webkit-slider-runnable-track { height: 1.5px; background: var(--awc); }
