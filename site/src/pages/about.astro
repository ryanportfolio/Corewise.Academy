      text-decoration: none; color: var(--ink);
      transition: background var(--dur) var(--ease);
    }
    /* each cell carries its sheet's ink as a drawn top tab, thicker on hover */
    .hold-cell::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--sheet-ink); transition: height var(--dur) var(--ease);
