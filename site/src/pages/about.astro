    .hold-k { font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.08em; color: var(--awg); line-height: 1.5; flex: 1; }
    .hold-url {
      font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.08em;
      color: var(--sheet-ink); border-top: 1px solid var(--line-soft); padding-top: 7px;
    }
    .hold-cell:hover .hold-url, .hold-cell:focus-visible .hold-url { text-decoration: underline; text-underline-offset: 3px; }
    .credo {
      font-family: var(--font-display); font-size: clamp(2.7rem, 6.3vw, 5rem); line-height: 1.18;
      margin: var(--s-4) 0 var(--s-2);
      display: flex; align-items: center; justify-content: space-between; gap: 0.35em; flex-wrap: wrap;
    }
    .credo span { white-space: nowrap; }
    .credo-shipped { flex: 1 0 100%; text-align: center; font-size: 2em; line-height: 1.05; }
    /* shooting-star connector: static shaft + head, plus a comet dash that streaks along it */
    .credo-star { width: 1.7em; height: 0.52em; flex: 1 0 auto; max-width: 3.2em; overflow: visible; }
    .cs-line { stroke: var(--awg); stroke-width: 1.4; fill: none; }
    .cs-head { stroke: var(--awc); stroke-width: 1.6; fill: none; stroke-linejoin: round; stroke-linecap: round; }
    .cs-comet {
      stroke: var(--accent-deep, var(--awc)); stroke-width: 2.2; fill: none; stroke-linecap: round;
      stroke-dasharray: 12 60; stroke-dashoffset: 12;
      animation: cs-streak 2.6s cubic-bezier(0.55, 0, 0.3, 1) infinite;
    }
    @keyframes cs-streak {
      0% { stroke-dashoffset: 12; opacity: 0; }
      12% { opacity: 1; }
