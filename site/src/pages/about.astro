    :global(#sec-a300.refusing .refuse-txt) { fill: var(--aw-verm); }
    :global(#sec-a300.refusing .refuse-path) { stroke: var(--aw-verm); }
    :global(#aw .post-live) { stroke: var(--aw-viri); stroke-width: 1.8; }

    /* ---- revisions table ---- */
    .rev { border-collapse: collapse; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: 0.06em; }
    .rev th { font-size: 0.58rem; letter-spacing: 0.16em; color: var(--awg); text-align: left; padding: 6px 18px 6px 0; border-bottom: 1px solid var(--awc); }
    .rev td { padding: 8px 18px 8px 0; border-bottom: 1px solid var(--line-soft); }
    .works { font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 2.1; }

    /* ---- prototype register ---- */
    .reg { width: 100%; }
    .reg .reg-no { white-space: nowrap; }
    .reg .reg-name { white-space: nowrap; letter-spacing: 0.08em; }
    .reg .reg-name a { color: var(--ink); text-decoration-color: var(--line); }
    .reg .reg-name a:hover { color: var(--accent-deep); }
    .reg .reg-desc { font-family: var(--font-body); font-size: var(--text-sm); letter-spacing: 0; color: var(--ink-soft); max-width: 62ch; }

    /* ---- A-600 featured works: one drawn detail per work ---- */
