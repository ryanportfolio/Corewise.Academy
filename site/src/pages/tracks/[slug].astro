---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { TRACKS, LEVELS } from '../../data/tracks';
import { TRACK_NOTES } from '../../data/trackNotes';

export function getStaticPaths() {
  return TRACKS.map((t) => ({ params: { slug: t.slug }, props: { track: t } }));
}

const { track } = Astro.props;
const notes = TRACK_NOTES[track.slug];
const guides = (await getCollection('guides')).filter(
  (g) => g.data.status === 'published' && g.data.track === track.slug,
);
const byLevel = (level: string) =>
  guides
    .filter((g) => g.data.level === level)
    .sort((a, b) => (a.data.courseOrder ?? a.data.number) - (b.data.courseOrder ?? b.data.number));
const levelMinutes = (level: string) => byLevel(level).reduce((sum, g) => sum + g.data.minutes, 0);
const totalMinutes = guides.reduce((sum, g) => sum + g.data.minutes, 0);

const faq = [
  {
    q: `What does the ${track.name} track cover?`,
    a: `${track.description} Guides are ordered Broad, then Practitioner, then Deep, and each one lists its prerequisites.`,
  },
  {
    q: 'How long does this track take to read?',
    a:
      guides.length > 0
        ? `The track currently holds ${guides.length} guide${guides.length > 1 ? 's' : ''}, about ${totalMinutes} minutes of reading in total. Each guide also ends with a short exercise you can run the same day.`
        : 'The first guides for this track are in editorial review now, so there is nothing to read here yet. Every guide arrives as a pull request and a human editor reviews it before it publishes.',
  },
  {
    q: 'Do I need to read the guides in order?',
    a: 'No. Levels run Broad to Deep and prerequisites are marked on every guide, so you can enter anywhere and follow the marked links back when a guide assumes something you have not read.',
  },
];
---

<Base
  title={`${track.name} track: ${notes.tagline} · CoreWise Academy`}
  description={track.description}
  faq={faq}
  crumbs={[{ name: `${track.name} track`, path: `/tracks/${track.slug}/` }]}
>
  <main>
    <header class="track-head">
      <p class="mono-label accent">Track {track.numeral} · {track.constellation}</p>
      <h1 class="display">{track.name}</h1>
      <p class="dek">{track.description}</p>
    </header>

    {
      LEVELS.map((l) => {
        const shelf = byLevel(l.id);
        return (
          <section class="shelf-section reveal">
            <div class="shelf-head">
              <h2>{l.label}</h2>
              <span class="mono-label">
                {shelf.length === 0 ? 'none yet' : `${shelf.length} guide${shelf.length > 1 ? 's' : ''}`}
              </span>
            </div>
            {shelf.length === 0 ? (
              <p class="empty-shelf">No guides at this level yet.</p>
            ) : (
              <ol class="shelf-list">
                {shelf.map((g) => (
                  <li>
                    <a href={`/guides/${g.id}/`}>
                      <span class="no">Nº {String(g.data.number).padStart(3, '0')}</span>
                      <span class="t">{g.data.title}</span>
                      <span class="m">{g.data.minutes} min</span>
                      <p>{g.data.description}</p>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </section>
        );
      })
    }

    <section class="track-notes reveal">
      <h2>Field notes on this track</h2>
      {notes.notes.map((p) => <p>{p}</p>)}
      <table class="syllabus">
        <thead>
          <tr><th>Level</th><th>Guides</th><th>Reading</th></tr>
        </thead>
        <tbody>
          {
            LEVELS.map((l) => (
              <tr>
                <td>{l.label}</td>
                <td class="mono">{byLevel(l.id).length}</td>
                <td class="mono">{levelMinutes(l.id)} minutes</td>
              </tr>
            ))
          }
          <tr class="total">
            <td>Whole track</td>
            <td class="mono">{guides.length}</td>
            <td class="mono">{totalMinutes} minutes</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="track-quotes reveal">
      <h2>Quotes from the guides</h2>
      {
        notes.quotes.map((q) => (
          <blockquote>
            <p>“{q.text}”</p>
            <cite><a href={q.href}>{q.guideTitle}</a></cite>
          </blockquote>
        ))
      }
    </section>

    <section class="track-sources reveal">
      <h2>Primary sources this track teaches from</h2>
      <ul class="source-roll">
        {
          notes.links.map((l) => (
            <li>
              <a href={l.href} rel="noopener">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="reveal">
      <Faq heading={`FAQ · the ${track.name} track`} items={faq} />
    </div>
  </main>

  <style>
    main { max-width: 70rem; margin: 0 auto; padding: var(--s-8) var(--s-4) var(--s-12); }
    .track-head { padding-bottom: var(--s-4); border-bottom: 1px solid var(--ink); }
    h1 { font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, var(--text-3xl)); margin: var(--s-2) 0; }
    .dek { font-size: var(--text-md); font-style: italic; color: var(--ink-soft); max-width: 52ch; }

    .shelf-section { padding: var(--s-6) 0; border-bottom: 1px solid var(--line); }
    .shelf-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--s-3); }
    .shelf-head h2 { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; }
    .shelf-name { color: var(--ink-mute); font-size: 0.7em; }
    .empty-shelf { color: var(--ink-mute); font-style: italic; max-width: 52ch; }

    .shelf-list { list-style: none; margin: 0; padding: 0; }
    .shelf-list li { border-bottom: 1px dashed var(--line); position: relative; }
    .shelf-list a {
      display: grid;
      grid-template-columns: 6.5rem 1fr auto;
      gap: 4px var(--s-3);
      text-decoration: none;
      color: var(--ink);
      align-items: baseline;
      position: relative;
      padding: var(--s-2) 0;
      transition: background var(--dur) var(--ease);
    }
    /* the constellation edge: an accent line draws itself along the divider on hover */
    .shelf-list a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background: repeating-linear-gradient(to right, var(--accent) 0 5px, transparent 5px 11px);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur) var(--ease);
    }
    .shelf-list .no { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent-deep); }
    /* the star that ignites: hidden until the row is sighted */
    .shelf-list .no::before {
      content: '✦';
      display: inline-block;
      margin-right: 0.55em;
      color: var(--accent);
      opacity: 0;
      transform: scale(0.3) rotate(-120deg);
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), text-shadow var(--dur) var(--ease);
    }
    .shelf-list .t {
      font-family: var(--font-display);
      font-size: var(--text-md);
      background: linear-gradient(currentColor, currentColor) no-repeat left 92% / 0% 1px;
      transition: color var(--dur) var(--ease), background-size var(--dur) var(--ease), text-shadow var(--dur) var(--ease);
    }
    .shelf-list .m { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--ink-mute); transition: color var(--dur) var(--ease); }
    .shelf-list p { grid-column: 2; margin: 0; padding-left: var(--s-3); font-size: var(--text-sm); color: var(--ink-soft); max-width: 52ch; }
    .shelf-list a:hover, .shelf-list a:focus-visible {
      background: var(--accent-wash);
    }
    .shelf-list a:hover::after, .shelf-list a:focus-visible::after { transform: scaleX(1); }
    .shelf-list a:hover .no::before, .shelf-list a:focus-visible .no::before {
      opacity: 1;
      transform: none;
      text-shadow: 0 0 14px var(--glow);
    }
    .shelf-list a:hover .t, .shelf-list a:focus-visible .t {
      color: var(--accent-deep);
      background-size: 100% 1px;
      text-shadow: 0 0 20px var(--glow);
    }
    .shelf-list a:hover .m, .shelf-list a:focus-visible .m { color: var(--accent-deep); }
    .track-notes, .track-quotes, .track-sources { padding: var(--s-6) 0; border-bottom: 1px solid var(--line); }
    .track-notes h2, .track-quotes h2, .track-sources h2 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 400;
      margin-bottom: var(--s-3);
    }
    .track-notes p { margin-bottom: var(--s-3); max-width: 68ch; color: var(--ink); }
    .syllabus { border-collapse: collapse; font-size: var(--text-sm); min-width: min(100%, 32rem); }
    .syllabus th {
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--ink-mute);
      text-align: left;
      border-bottom: 1px solid var(--ink);
      padding: var(--s-1) var(--s-4) var(--s-1) 0;
    }
    .syllabus td { border-bottom: 1px dashed var(--line); padding: var(--s-2) var(--s-4) var(--s-2) 0; }
    .syllabus .mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-soft); }
    .syllabus .total td { border-bottom: none; border-top: 1px solid var(--ink); font-weight: 600; }
    .track-quotes blockquote { margin: 0 0 var(--s-3); padding-left: var(--s-3); border-left: 3px solid var(--accent-deep); max-width: 60ch; }
    .track-quotes blockquote p { font-style: italic; font-size: var(--text-md); line-height: 1.3; }
    .track-quotes cite { font-family: var(--font-mono); font-size: var(--text-2xs); font-style: normal; color: var(--ink-mute); }
    .track-quotes cite a { color: var(--ink-soft); }
    .source-roll { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
    .source-roll li { border-bottom: 1px dashed var(--line); padding: var(--s-1) 0; font-size: var(--text-sm); }
    .source-roll a { color: var(--ink-soft); text-decoration: none; }
    .source-roll a:hover { color: var(--accent-deep); }

    @media (max-width: 720px) {
      .shelf-list a { grid-template-columns: 1fr auto; }
      .shelf-list .no { display: none; }
      .shelf-list p { grid-column: 1 / -1; padding-left: 0; }
    }
  </style>
</Base>
