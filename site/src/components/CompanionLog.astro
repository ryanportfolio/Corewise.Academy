---
// The guide's closing ledger entry: one measured result from the companion
// field log at savetokens.tips. The bar width IS the datum (81.8% removed),
// so the graphic can never disagree with the number beside it.
interface Props {
  href?: string;
  /** Percentage of output tokens removed, measured on the log. */
  removed?: number;
  /** Rounded command sample, shown with an "and counting" frame. */
  sample?: string;
  /** Total tokens saved, headline figure. */
  saved?: string;
}
const {
  href = 'https://savetokens.tips',
  removed = 81.8,
  sample = '94k',
  saved = '19.1M',
} = Astro.props;
const kept = Math.round((100 - removed) * 10) / 10;
---

<aside class="companion-log">
  <span class="panel-label">Companion log · savetokens.tips</span>
  <p class="cl-lede">
    Every fix in this guide, measured on a live log. It records what output
    filtering actually strips before the agent reads it, command by command.
  </p>

  <div class="cl-figure">
    <div class="cl-stat">
      <span class="cl-num">{removed}<span class="cl-pct">%</span></span>
      <span class="cl-cap">of output tokens<br />removed</span>
    </div>
    <div class="cl-meter">
      <div
        class="cl-bar"
        role="img"
        aria-label={`${removed} percent of output tokens removed, ${kept} percent kept`}
      >
        <span class="cl-removed" style={`width:${removed}%`}></span>
      </div>
      <p class="cl-legend">
        <span><i class="sw removed"></i>removed</span>
        <span><i class="sw kept"></i>kept</span>
        <span class="cl-note">logged, not estimated</span>
      </p>
    </div>
  </div>

  <p class="cl-foot">
    <span>≈{sample} commands and counting</span>
    <span class="dot">·</span>
    <span>{saved} tokens saved</span>
  </p>

  <a class="cl-link" href={href}>Open the log <span aria-hidden="true">→</span></a>
</aside>

<style>
  .companion-log {
    margin: var(--s-8) 0 var(--s-6);
    padding: var(--s-4);
    background: var(--panel);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent-deep);
  }

  .panel-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-mute);
    margin-bottom: var(--s-2);
  }

  .cl-lede {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 var(--s-3);
  }

  /* measured-result specimen: hero number + the bar it describes */
  .cl-figure {
    display: flex;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-3) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .cl-stat {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
    flex: 0 0 auto;
  }
  .cl-num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 0.9;
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
  .cl-pct { font-size: 0.45em; }
  .cl-cap {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-mute);
    line-height: 1.3;
  }

  .cl-meter { flex: 1 1 auto; min-width: 0; }
  .cl-bar {
    display: flex;
    height: 12px;
    background: var(--accent-wash);
    border: 1px solid var(--line);
  }
  .cl-removed {
    display: block;
    height: 100%;
    background: var(--accent);
    /* hairline seam between removed and kept */
    border-right: 1px solid var(--accent-deep);
  }

  .cl-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin: var(--s-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-mute);
  }
  .sw {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 0.5ch;
    vertical-align: -1px;
    border: 1px solid var(--line);
  }
  .sw.removed { background: var(--accent); }
  .sw.kept { background: var(--accent-wash); }
  .cl-note { margin-left: auto; font-style: normal; color: var(--accent-deep); }

  .cl-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: var(--s-2) 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .cl-foot .dot { color: var(--ink-mute); }

  .cl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--accent-deep);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-bottom: 2px;
  }
  .cl-link span { transition: transform var(--dur) var(--ease); }
  .cl-link:hover span { transform: translateX(4px); }
  .cl-link:hover { border-bottom-color: var(--accent); }

  @media (max-width: 33rem) {
    .cl-figure { flex-direction: column; align-items: stretch; gap: var(--s-2); }
    .cl-stat { justify-content: flex-start; }
  }
</style>
