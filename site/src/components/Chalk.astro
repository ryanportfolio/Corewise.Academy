---
// Handwritten chalk note in the margin: the lecturer's aside.
---

<span class="chalk"><slot /></span>

<style>
  .chalk {
    position: absolute;
    right: -12.6rem;
    width: 10.9rem;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--ink-mute);
    transform: rotate(-2.5deg);
  }
  .chalk::before { content: '☞ '; }
  @media (max-width: 1200px) {
    .chalk {
      position: static;
      width: auto;
      transform: none;
      display: block;
      margin: var(--s-2) 0;
    }
  }
</style>
